# Editor / IDE
.idea/
.vscode/

# OS
.DS_Store
Thumbs.db

# Agent planning artifacts — not part of the published repo.
# The skills write specs/plans under docs/megapowers/{specs,plans}; the bare
# docs/{plans,specs} paths are kept for older layouts.
docs/megapowers/
docs/plans/
docs/specs/

# Runtime state written by skills (autonomous-run dirs, evidence) — never part
# of the published repo.
.megapowers/

# Local agent state and per-machine MCP config — never part of the published repo.
.claude/
.codex/
.mcp.json
.firecrawl/

# Local env files carry secrets — never part of the published repo.
.env
.env.*

# Sandbox/agent workspace artifacts that materialize inside study dirs — never real content.
evals/studies/**/.claude/
evals/studies/**/.mcp.json
evals/.runs/

# Linked git worktrees created for isolated feature work.
.worktrees/
/results/
