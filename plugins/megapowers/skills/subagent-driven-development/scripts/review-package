#!/usr/bin/env bash
# Generate a review package containing the committed range and every current
# task change. This permits review before a task is committed.
#
# Usage: review-package BASE HEAD [OUTFILE]
# Default OUTFILE: <repo-root>/.megapowers/sdd/review-<base7>..<head7>.diff
# (named per range, so a re-review after fixes gets a distinct fresh file).
# Tested by tests/workspace-and-review-package.test.sh (run via scripts/validate.sh).
set -euo pipefail

if [ $# -lt 2 ] || [ $# -gt 3 ]; then
  echo "usage: review-package BASE HEAD [OUTFILE]" >&2
  exit 2
fi

base=$1
head=$2

git rev-parse --verify --quiet "$base" >/dev/null || { echo "bad BASE: $base" >&2; exit 2; }
git rev-parse --verify --quiet "$head" >/dev/null || { echo "bad HEAD: $head" >&2; exit 2; }

if [ $# -eq 3 ]; then
  out=$3
else
  dir=$("$(cd "$(dirname "$0")" && pwd)/sdd-workspace")
  out="$dir/review-$(git rev-parse --short "$base")..$(git rev-parse --short "$head").diff"
fi

tmp="$(mktemp "${out}.tmp.XXXXXX")"
trap 'rm -f -- "$tmp"' EXIT
{
  echo "# Review package: ${base}..${head}"
  echo
  echo "## Commits"
  git log --oneline "${base}..${head}"
  echo
  echo "## Files changed"
  git diff --stat "${base}..${head}"
  echo
  echo "## Diff"
  git diff -U10 "${base}..${head}"
  echo
  echo "## Staged changes"
  git diff --cached -U10
  echo
  echo "## Unstaged changes"
  git diff -U10
  echo
  echo "## Untracked changes"
  found_untracked=false
  while IFS= read -r -d '' file; do
    [[ "$file" -ef "$out" ]] && continue
    [[ "$file" -ef "$tmp" ]] && continue
    found_untracked=true
    if git diff --no-index -- /dev/null "$file"; then
      :
    else
      diff_rc=$?
      if [ "$diff_rc" -ne 1 ]; then
        printf 'review-package: git diff failed for untracked path %q (exit %d)\n' \
          "$file" "$diff_rc" >&2
        exit "$diff_rc"
      fi
    fi
  done < <(git ls-files --others --exclude-standard -z)
  if [ "$found_untracked" = false ]; then
    echo "(none)"
  fi
} > "$tmp"
mv -f -- "$tmp" "$out"
trap - EXIT

commits=$(git rev-list --count "${base}..${head}")
echo "wrote ${out}: ${commits} commit(s), $(wc -c < "$out" | tr -d ' ') bytes"
