#!/usr/bin/env bash
# mem-recall — implementation is mem-recall.go
set -euo pipefail
dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export MEGAPOWERS_SCRIPT_DIR="$dir"
src="$dir/mem-recall.go"
cache="${GOCACHE:-${TMPDIR:-/tmp}/megapowers-gocache}"
mkdir -p "$cache"
bin="$cache/mem-recall-$(cksum "$src" | awk '{print $1}')"
if [[ ! -x $bin || $src -nt $bin ]]; then
  command -v go >/dev/null || { echo "mem-recall: go is required" >&2; exit 2; }
  go build -o "$bin" "$src" || exit 2
fi
exec "$bin" "$@"
