#!/usr/bin/env bash
# render-model-catalog [--caller <harness>]: print a compact always-in-context
# summary of the model catalog (models.toml), resolved across layers: project
# .megapowers/models.toml, user ${XDG_CONFIG_HOME:-~/.config}/megapowers/models.toml,
# then the copy shipped at this plugin's root. MODELS_TOML overrides with a single
# file (tests, CI).
#
# --caller names the harness this block is being rendered for, and that harness
# leads its own session. The catalog [lead] key is only the default for a session
# that declares nothing, so when the caller differs it moves off the lead line and
# is labelled as the fallback it is. Each adapter passes its own name; the flag is
# optional and absent means "assume the catalog lead", which is what an undeclared
# session gets anyway.
#
# Fail-open by design: no catalog, unreadable file, malformed content, or an empty
# --caller value prints the best block it can (or nothing) and exits 0; the
# SessionStart payload simply omits or under-specifies the block rather than
# breaking session start.
# Tested by tests/render-model-catalog.test.sh (run via scripts/validate.sh).
set -u

caller=""
caller_model=""
while [ $# -gt 0 ]; do
  case "$1" in
    --caller) caller="${2:-}"; shift 2 || shift $# ;;
    --caller-model) caller_model="${2:-}"; shift 2 || shift $# ;;
    *) shift ;;
  esac
done

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib-toml.sh
. "$SCRIPT_DIR/lib-toml.sh"
files=()
if [ -n "${MODELS_TOML:-}" ]; then
  files=("$MODELS_TOML")
else
  [ -f ".megapowers/models.toml" ] && files+=(".megapowers/models.toml")
  u="${XDG_CONFIG_HOME:-$HOME/.config}/megapowers/models.toml"
  [ -f "$u" ] && files+=("$u")
  [ -f "$SCRIPT_DIR/../models.toml" ] && files+=("$SCRIPT_DIR/../models.toml")
fi
[ "${#files[@]}" -gt 0 ] || exit 0

# Layer walk: the first readable file that DEFINES a key wins it outright. The
# leaf readers live in lib-toml.sh; only the precedence policy is local.
val() {  # $1=section $2=key -> first file that defines it wins
  local f v
  for f in "${files[@]}"; do
    [ -r "$f" ] || continue
    toml_key_exists_in "$f" "$1" "$2" 2>/dev/null || continue
    v="$(toml_scalar_in "$f" "$1" "$2" 2>/dev/null)"
    printf '%s' "$v"
    return 0
  done
  return 1
}
arr() {  # $1=section $2=key -> elements one per line, first file wins
  local f out
  for f in "${files[@]}"; do
    [ -r "$f" ] || continue
    toml_key_exists_in "$f" "$1" "$2" 2>/dev/null || continue
    out="$(toml_array_in "$f" "$1" "$2" 2>/dev/null)"
    [ -n "$out" ] && printf '%s\n' "$out"
    return 0
  done
  return 1
}
providers() {  # provider names, union across files, file order
  local f
  for f in "${files[@]}"; do
    [ -r "$f" ] || continue
    toml_provider_names_in "$f" 2>/dev/null
  done | awk '!seen[$0]++'
}

lp="$(val lead provider)" || exit 0
lt="$(val lead tier)" || lt=""
lm=""
if [ -n "$lt" ]; then lm="$(val "providers.$lp.tiers" "$lt")" || lm=""; fi

tier_lines=""
while IFS= read -r t; do
  [ -n "$t" ] || continue
  m="$(val "providers.$lp.tiers" "$t")" || m=""
  u="$(val tiers.use "$t")" || u=""
  tier_lines="${tier_lines:+$tier_lines | }${t}=${m:-?}${u:+ (}${u}${u:+)}"
done <<< "$(arr tiers scale)"
[ -n "$tier_lines" ] || exit 0

eff_lines=""
while IFS= read -r e; do
  [ -n "$e" ] || continue
  u="$(val efforts.use "$e")" || u=""
  eff_lines="${eff_lines:+$eff_lines | }${e}${u:+=$u}"
done <<< "$(arr efforts scale)"

del_lines=""
while IFS= read -r p; do
  [ -n "$p" ] || continue
  [ "$p" = "$lp" ] && continue
  en="$(val "providers.$p" enabled)" || en=""
  [ "$en" = "false" ] && continue
  u="$(val "providers.$p" use)" || u=""
  dt="$(val "providers.$p" default_tier)" || dt=""
  dm=""
  if [ -n "$dt" ]; then dm="$(val "providers.$p.tiers" "$dt")" || dm=""; fi
  del_lines="${del_lines:+$del_lines | }${p}=${u:-${dm:-?}}"
done <<< "$(providers)"

floor="$(val defaults floor)" || floor=""

render() {
  printf 'Model catalog (models.toml; override layers project>user>shipped):\n'
  # The lead line is the one claim a session acts on without reading further, so
  # it names whoever is actually in charge. A declared caller that is not the
  # catalog lead gets the line, and [lead] follows as the fallback it is.
  # The running model rides the line only when it DIFFERS from the catalog's
  # lead model: the 2026-08 audit found this block asserting a model that was
  # not running, which is the one claim on the line a session cannot check.
  runline=""
  if [ -n "$caller_model" ] && [ "$caller_model" != "$lm" ]; then
    runline="; this session runs $caller_model"
  fi
  if [ -n "$caller" ] && [ "$caller" != "$lp" ]; then
    printf 'lead: %s, the harness running this session%s. Catalog default (undeclared sessions only): %s%s%s\n' \
      "$caller" "$runline" "$lp" "${lt:+ $lt}" "${lm:+ ($lm)}"
  else
    printf 'lead: %s%s%s%s\n' "$lp" "${lt:+ $lt}" "${lm:+ ($lm)}" "$runline"
  fi
  printf 'tiers: %s\n' "$tier_lines"
[ -n "$eff_lines" ] && printf 'efforts: %s\n' "$eff_lines"
  [ -n "$del_lines" ] && printf 'delegates: %s\n' "$del_lines"
  printf '%sRoutes: delegate-resolve <role> (mega-orchestration:multi-agent-delegation).\n' "${floor:+floor $floor. }"
  return 0
}
# Sanitize and clamp: catalog values are user-owned input headed for every
# session's context. Strip control bytes escape_for_json cannot represent
# (keep tab, LF, CR) and bound the block so an override layer cannot bloat
# the always-loaded payload. 1024 -> 1400 on 2026-08-12 for the declared-caller
# lead line: the shipped catalog renders 1045B with a caller and a machine
# running two extra delegate rows renders ~1100B, so the old clamp would have cut
# the Routes line off the block it was meant to bound. The tests hold the shipped
# catalog to 980B plain and 1100B with a caller; this clamp is the backstop for
# override layers, not the budget.
render | tr -d '\000-\010\013\014\016-\037' | head -c 1400
exit 0
