#!/usr/bin/env bash
# effect-broker — implementation is effect-broker.go
set -euo pipefail
dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
src="$dir/effect-broker.go"
cache="${GOCACHE:-${TMPDIR:-/tmp}/megapowers-gocache}"
mkdir -p "$cache"
bin="$cache/effect-broker-$(cksum "$src" | awk '{print $1}')"
if [[ ! -x $bin || $src -nt $bin ]]; then
  command -v go >/dev/null || { echo "effect-broker: go is required" >&2; exit 2; }
  go build -o "$bin" "$src" || exit 2
fi
exec "$bin" "$@"
