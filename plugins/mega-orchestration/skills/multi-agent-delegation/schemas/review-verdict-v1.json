{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Megapowers Review Verdict v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "findings", "next_steps", "evidence"],
  "properties": {
    "verdict": {"enum": ["approve", "needs_attention"]},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "file", "lines", "confidence", "finding", "recommendation"],
        "properties": {
          "severity": {"enum": ["critical", "major", "minor"]},
          "file": {"type": "string"},
          "lines": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "finding": {"type": "string"},
          "recommendation": {"type": "string"}
        }
      }
    },
    "next_steps": {"type": "array", "items": {"type": "string"}},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commands", "screenshots"],
      "properties": {
        "commands": {"type": "array", "items": {"type": "string"}},
        "screenshots": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "allOf": [
    {
      "$comment": "An approve is only valid when every finding is minor. delegate-run enforces the same rule on the provider result before it writes a receipt, because the Stop hook trusts result.verdict on its own and an approve carrying a critical finding would open the gate on a tree the reviewer said was broken. Both provider adapters delete this keyword from the schema they send, since strict structured-output modes reject if/then.",
      "if": {
        "type": "object",
        "required": ["verdict"],
        "properties": {"verdict": {"const": "approve"}}
      },
      "then": {
        "properties": {
          "findings": {
            "type": "array",
            "items": {"properties": {"severity": {"const": "minor"}}}
          }
        }
      }
    }
  ]
}
