#!/usr/bin/env bash
# delegate-resolve <role> — resolve a role to its provider + invocation details by
# reading delegates.toml. Makes routing EXECUTED rather than eyeballed: any harness
# can run this (or read its KEY=VALUE output) to learn where a role goes and how to
# reach it. Portable: bash + awk, no external deps.
# Tested by tests/delegate-resolve.test.sh (run via scripts/validate.sh).
#
# Config layering: DELEGATES_TOML (env) and --config are exclusive single-file
# modes; when either is set, only that file is read. Otherwise up to three layers
# merge per key, highest priority first:
#   1. project  .megapowers/delegates.toml            (relative to the caller's cwd)
#   2. user     ${XDG_CONFIG_HOME:-~/.config}/megapowers/delegates.toml
#   3. shipped  the delegates.toml in this skill's directory (always present)
# The first layer that defines a key wins; arrays replace whole, never merge.
# `--where` prints the active layers in priority order.
#
# Catalog stack: the model catalog (lead, tiers, providers, floor) lives in
# models.toml, layered the same way: MODELS_TOML (env) and --models are exclusive
# single-file modes; otherwise project .megapowers/models.toml, then user
# ${XDG_CONFIG_HOME:-~/.config}/megapowers/models.toml, then the copy shipped at
# this plugin's root. Catalog data resolves DELEGATES stack first (legacy
# compatibility: provider sections in delegates.toml layers win), then the
# catalog stack. The catalog stack may be empty.
#
# Reads a restricted TOML subset via lib-toml.sh, which owns the grammar and ships
# as a byte-twin here and in plugins/megapowers/hooks/ (plugins cannot locate each
# other at runtime; scripts/validate.sh fails on drift). This file owns only the
# layer-precedence policy: which file wins a key, and how the two stacks combine.
#
# Resolution walks the role's fallback chain (or its single [roles] provider when it
# has none), skipping any candidate that is --excluded, disabled, or whose CLI is not
# installed (checked with `command -v <binary>`: a route to an absent CLI is a
# fabricated primitive). The first usable candidate wins. It prints DISPATCH=native
# when the winner IS the caller, meaning run this with the harness's own subagent or
# workflow rather than shelling out to your own CLI.
#
# A role whose [roles] value is `self` resolves to the CALLER's own provider instead:
# --author-model / --author-vendor when given, else the catalog [lead]. That is the
# default for roles with no [independence] policy, so an ordinary delegated step costs
# no third-party call. Independence roles keep their cross-vendor chains.
#
# DISPATCH says HOW to run the resolved route: `native` when it landed on the caller's
# own provider, where the harness's own subagent/team/workflow is the right
# instrument and CHANNEL/BINARY do not apply, or `cli` when it crosses runtimes.
#
# Usage:
#   delegate-resolve <role> [--config <file>] [--models <file>]
#                    [--author-vendor <vendor>]... [--author-model <id>]...
#                    [--author-provider <name>]...
#                    [--exclude <vendor|provider>]... [--list]
#   delegate-resolve --preset <name> [--config <file>]
#   delegate-resolve --list-presets [--config <file>]
#   delegate-resolve [<role>] --vendors [--config <file>]  # reachable vendors, one/line
#                    (with a role: only vendors that role could actually resolve to)
#   delegate-resolve --where [--config <file>]
#   delegate-resolve --lead | --exclude-lead | --check [--config <file>]
# Exit:  0 resolved · 2 usage/config/parse error · 3 unknown role OR no available
#        route (every candidate excluded/disabled/absent) · 4 provider disabled (a
#        single-route role whose only provider is switched off in config)
#        --check: 0 clean, 1 schema findings.
set -uo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
shipped="$here/../delegates.toml"   # scripts/../delegates.toml
# shellcheck source=lib-toml.sh
. "$here/lib-toml.sh"

usage() {
  echo "usage: delegate-resolve <role> [--config <file>] [--models <file>] [--author-vendor <vendor>]... [--author-model <id>]... [--author-provider <name>]... [--exclude <vendor|provider>]... [--list]" >&2
  echo "       delegate-resolve --preset <name> [--config <file>] | --list-presets | --vendors | --where | --lead | --check" >&2
}

role=""; list=0; preset=""; list_presets=0; where=0; lead=0; exclude_lead=0; check=0; vendors=0; cfg=""; mcfg=""; excludes=(); author_vendors=(); author_models=(); author_providers=(); caller_models=(); caller_providers=()
while [ $# -gt 0 ]; do
  case "$1" in
    --config) [ $# -ge 2 ] || { echo "delegate-resolve: --config needs a file argument" >&2; usage; exit 2; }
              cfg="$2"; shift 2 ;;
    --models) [ $# -ge 2 ] || { echo "delegate-resolve: --models needs a file argument" >&2; usage; exit 2; }
              mcfg="$2"; shift 2 ;;
    --exclude) [ $# -ge 2 ] || { echo "delegate-resolve: --exclude needs a vendor or provider name" >&2; usage; exit 2; }
              excludes+=("$2"); shift 2 ;;
    --author-vendor) [ $# -ge 2 ] || { echo "delegate-resolve: --author-vendor needs a vendor name" >&2; usage; exit 2; }
              author_vendors+=("$2"); shift 2 ;;
    --author-model) [ $# -ge 2 ] || { echo "delegate-resolve: --author-model needs a model id" >&2; usage; exit 2; }
              author_models+=("$2"); shift 2 ;;
    --author-provider) [ $# -ge 2 ] || { echo "delegate-resolve: --author-provider needs a provider name" >&2; usage; exit 2; }
              author_providers+=("$2"); shift 2 ;;
    --caller-model) [ $# -ge 2 ] || { echo "delegate-resolve: --caller-model needs a model id" >&2; usage; exit 2; }
              caller_models+=("$2"); shift 2 ;;
    --caller-provider) [ $# -ge 2 ] || { echo "delegate-resolve: --caller-provider needs a provider name" >&2; usage; exit 2; }
              caller_providers+=("$2"); shift 2 ;;
    --preset) [ $# -ge 2 ] || { echo "delegate-resolve: --preset needs a name" >&2; usage; exit 2; }
              preset="$2"; shift 2 ;;
    --list) list=1; shift ;;
    --list-presets) list_presets=1; shift ;;
    --vendors) vendors=1; shift ;;
    --where) where=1; shift ;;
    --lead) lead=1; shift ;;
    --exclude-lead) exclude_lead=1; shift ;;
    --check) check=1; shift ;;
    -h|--help) usage; exit 0 ;;
    -*) usage; exit 2 ;;
    *) role="$1"; shift ;;
  esac
done

# --- config layers -----------------------------------------------------------------
tomls=()
if [ -n "${DELEGATES_TOML:-}" ]; then
  tomls=("$DELEGATES_TOML")
elif [ -n "$cfg" ]; then
  tomls=("$cfg")
else
  [ -f ".megapowers/delegates.toml" ] && tomls+=(".megapowers/delegates.toml")
  user_toml="${XDG_CONFIG_HOME:-$HOME/.config}/megapowers/delegates.toml"
  [ -f "$user_toml" ] && tomls+=("$user_toml")
  tomls+=("$shipped")
fi
layers=()
for f in "${tomls[@]}"; do
  if [ ! -f "$f" ]; then echo "delegate-resolve: no config at $f" >&2; exit 2; fi
  if [ ! -r "$f" ]; then echo "delegate-resolve: cannot read $f (layer skipped)" >&2; continue; fi
  layers+=("$f")
done
[ "${#layers[@]}" -gt 0 ] || { echo "delegate-resolve: no readable config" >&2; exit 2; }

# --- catalog layers (models.toml) --------------------------------------------------
plugin_models="$here/../../../models.toml"   # <plugin root>/models.toml
mtomls=()
if [ -n "${MODELS_TOML:-}" ]; then
  mtomls=("$MODELS_TOML")
elif [ -n "$mcfg" ]; then
  mtomls=("$mcfg")
else
  [ -f ".megapowers/models.toml" ] && mtomls+=(".megapowers/models.toml")
  user_models="${XDG_CONFIG_HOME:-$HOME/.config}/megapowers/models.toml"
  [ -f "$user_models" ] && mtomls+=("$user_models")
  [ -f "$plugin_models" ] && mtomls+=("$plugin_models")
fi
mlayers=()
for f in ${mtomls[@]+"${mtomls[@]}"}; do
  if [ ! -f "$f" ]; then echo "delegate-resolve: no catalog at $f" >&2; exit 2; fi
  if [ ! -r "$f" ]; then echo "delegate-resolve: cannot read $f (layer skipped)" >&2; continue; fi
  mlayers+=("$f")
done

if [ "$where" -eq 1 ]; then
  printf '%s\n' "${layers[@]}"
  [ "${#mlayers[@]}" -gt 0 ] && printf '%s\n' "${mlayers[@]}"
  exit 0
fi

# --- restricted-TOML parse guard -----------------------------------------------------
# A syntactically broken layer must fail loudly (exit 2, naming file and line), not
# be mistaken for an unknown role (exit 3).
for f in "${layers[@]}" ${mlayers[@]+"${mlayers[@]}"}; do
  lint="$(awk '
    { s=$0; sub(/^[[:space:]]+/,"",s); sub(/[[:space:]]+$/,"",s) }
    s=="" || s ~ /^#/ { next }
    s ~ /^\[[A-Za-z0-9_.-]+\][[:space:]]*(#.*)?$/ { next }
    s ~ /^[A-Za-z0-9_.-]+[[:space:]]*=/ { next }
    { printf "%d\t%s", NR, $0; exit }
  ' "$f")"
  if [ -n "$lint" ]; then
    ln="${lint%%$'\t'*}"; txt="${lint#*$'\t'}"
    echo "delegate-resolve: parse error in $f at line $ln: $txt" >&2
    exit 2
  fi
done

# --- readers -------------------------------------------------------------------------
# Scalar and array lookups return the first (highest-priority) layer's value;
# existence checks and listings union across layers.

section_exists_in() { toml_section_exists_in "$1" "$2"; }
section_exists() { local f; for f in "${layers[@]}"; do section_exists_in "$f" "$1" && return 0; done; return 1; }
key_exists_in() { toml_key_exists_in "$1" "$2" "$3"; }

list_roles() {
  local f
  for f in "${layers[@]}"; do
    awk '{h=$0; gsub(/[[:space:]]/,"",h)} h=="[roles]"{r=1;next} /^[[:space:]]*\[/{r=0} r && /=/{l=$0;sub(/=.*/,"",l);gsub(/[[:space:]]/,"",l);if(l!="")print l}' "$f"
  done | awk '!seen[$0]++'
}

list_preset_names() {
  local f
  for f in "${layers[@]}"; do
    awk '{h=$0; gsub(/[[:space:]]/,"",h)} h ~ /^\[presets\./{n=h; sub(/^\[presets\./,"",n); sub(/\].*/,"",n); if(n!="")print n}' "$f"
  done | awk '!seen[$0]++'
}

section_val_in() { toml_scalar_in "$1" "$2" "$3"; }
section_val() {  # $1=section $2=key -> first layer that defines the key wins
  local f v
  for f in "${layers[@]}"; do
    key_exists_in "$f" "$1" "$2" || continue
    v="$(section_val_in "$f" "$1" "$2")"
    printf '%s\n' "$v"
    return 0
  done
  return 1
}

array_val_in() { toml_array_in "$1" "$2" "$3"; }
array_val() {  # $1=section $2=key -> the first layer that defines the key wins whole
  local f out
  for f in "${layers[@]}"; do
    key_exists_in "$f" "$1" "$2" || continue
    out="$(array_val_in "$f" "$1" "$2")"
    [ -n "$out" ] && printf '%s\n' "$out"
    return 0
  done
  return 1
}

msection_exists() { local f; for f in ${mlayers[@]+"${mlayers[@]}"}; do section_exists_in "$f" "$1" && return 0; done; return 1; }
msection_val() {
  local f v
  for f in ${mlayers[@]+"${mlayers[@]}"}; do
    key_exists_in "$f" "$1" "$2" || continue
    v="$(section_val_in "$f" "$1" "$2")"
    printf '%s\n' "$v"
    return 0
  done
  return 1
}
marray_val() {
  local f out
  for f in ${mlayers[@]+"${mlayers[@]}"}; do
    key_exists_in "$f" "$1" "$2" || continue
    out="$(array_val_in "$f" "$1" "$2")"
    [ -n "$out" ] && printf '%s\n' "$out"
    return 0
  done
  return 1
}

# Catalog data (lead, tiers, providers, floor) resolves DELEGATES stack first
# (an inline provider section in a routing layer wins), then the
# catalog stack.
cat_exists() { section_exists "$1" || msection_exists "$1"; }
cat_val() {
  section_val "$1" "$2" && return 0
  msection_val "$1" "$2"
}
cat_array() {
  array_val "$1" "$2" && return 0
  marray_val "$1" "$2"
}

# Is a value one of the lines in a newline-separated list. Every membership test
# below goes through here, and none of them may use a pipeline.
#
# `printf '%s\n' "$list" | grep -qx -- "$v"` read as the obvious spelling and was
# not: `grep -q` exits at the FIRST match, so bash's line-at-a-time write of the
# rest of the list lands on a closed pipe and the writer dies of SIGPIPE. `set -o
# pipefail` then promotes that 141 to the pipeline's status, so a value that IS in
# the list reads as absent. It needs the match to be somewhere other than the last
# line and the reader to win the race, which is why it showed up as a rare red in
# a loaded validate.sh run and never in a serial re-run. Resolution used the same
# spelling, so the same race could refuse a valid tier, effort, or capability and
# exit 2 on a route that is fine.
#
# Comparing in the shell has no pipeline to fail, is exact rather than a basic
# regex (a tier or capability containing `.` or `[` now means itself), and drops
# two forks per call.
list_has() {  # $1=newline-separated list $2=value
  case $'\n'"$1"$'\n' in
    *$'\n'"$2"$'\n'*) return 0 ;;
  esac
  return 1
}

fallbacks_of() { array_val fallbacks "$1"; }

providers_list() {  # every [providers.X] name across layers (tier subsections excluded)
  local f
  for f in "${layers[@]}" ${mlayers[@]+"${mlayers[@]}"}; do
    toml_provider_names_in "$f"
  done | awk '!seen[$0]++'
}

# model id and tier for a provider: default_tier maps through [providers.X.tiers];
# a provider without default_tier falls back to its legacy `model` key (schema v1).
provider_model() {  # $1=provider ; prints "model<TAB>tier"
  local p="$1" dt m
  dt="$(cat_val "providers.$p" default_tier)"
  if [ -n "$dt" ]; then
    m="$(cat_val "providers.$p.tiers" "$dt")"
    if [ -z "$m" ]; then
      echo "delegate-resolve: provider '$p': default_tier '$dt' has no [providers.$p.tiers] entry" >&2
      return 2
    fi
    printf '%s\t%s\n' "$m" "$dt"
  else
    printf '%s\t\n' "$(cat_val "providers.$p" model)"
  fi
}

scale_list="$(cat_array tiers scale)"   # empty on v1 configs
tier_index() { printf '%s\n' "$scale_list" | grep -nx -- "$1" | cut -d: -f1; }

# --- who is asking -------------------------------------------------------------------
# A harness always knows the model id it is running; it does not necessarily know
# the vendor name this catalog files that model under, and a BYO-model harness
# (OpenCode, Cursor CLI, pi) has no fixed vendor to hardcode at all. --author-model
# derives the vendor, so an instruction file says "pass your model id" once instead
# of pinning a vendor per harness. Both schemas are searched: a tier entry and v1's
# bare `model` key.
providers_for_model() {  # $1=model id -> every provider declaring it, one per line
  local want="$1" p t m
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    m="$(cat_val "providers.$p" model)"
    if [ "$m" = "$want" ]; then printf '%s\n' "$p"; continue; fi
    while IFS= read -r t; do
      [ -n "$t" ] || continue
      m="$(cat_val "providers.$p.tiers" "$t")"
      [ "$m" = "$want" ] && { printf '%s\n' "$p"; break; }
    done <<< "$scale_list"
  done <<< "$(providers_list)"
}

vendors_of_providers() {  # stdin: provider names -> their distinct vendors
  local p v
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    v="$(cat_val "providers.$p" vendor)"
    printf '%s\n' "${v:-$p}"
  done | awk '!seen[$0]++'
}

# self_provider is the caller's own provider: the target for a `self`-routed role,
# and the thing an independence role routes AWAY from. An author model contributes
# its vendor to author_vendors, so independence behaves identically either way.
self_provider=""; self_ambiguous=""; self_identity_conflict=""
# Each identity FLAG OCCURRENCE is one assertion about the single caller a `self`
# role has, so every occurrence narrows the answer and they all intersect. A flag
# whose token is ambiguous contributes a disjunction (the caller is one of these),
# which is why intersecting occurrences can resolve what none of them resolves alone.
self_candidates=""; self_sources=0; self_declared=""
dedupe_lines() { printf '%s\n' "$1" | grep . | awk '!seen[$0]++'; }
add_identity_set() {  # $1=providers this occurrence allows, $2=how it was declared
  local set_; set_="$(dedupe_lines "$1")"
  [ -n "$set_" ] || return 0
  self_declared="$self_declared${self_declared:+, }$2"
  if [ "$self_sources" -eq 0 ]; then
    self_candidates="$set_"
  else
    self_candidates="$(printf '%s\n' "$self_candidates" | grep -Fxf <(printf '%s\n' "$set_"))"
  fi
  self_sources=$((self_sources + 1))
  [ -n "$(printf '%s\n' "$self_candidates" | grep .)" ] || self_identity_conflict="yes"
}

# --author-vendor takes a vendor OR a provider name, but authorship is a VENDOR
# claim: excluding only the named provider would leave a sibling provider of the same
# vendor eligible to review its own author's work. Normalize to the vendor up front,
# so both the exclusion set and the echoed AUTHOR_VENDORS speak vendors.
# A provider name and a vendor name share this flag's namespace, so one token can hit
# both. Preferring either silently would normalize to the wrong vendor and leave the
# intended author eligible, so a token that means two different vendors is refused;
# --author-provider addresses the provider namespace on its own.
vendor_for_author_token() {  # $1=vendor or provider name -> vendor; 1 none, 2 shadowed
  local tok="$1" p v as_provider="" as_vendor=""
  if cat_exists "providers.$tok"; then
    v="$(cat_val "providers.$tok" vendor)"
    as_provider="${v:-$tok}"
  fi
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    [ "$(cat_val "providers.$p" vendor)" = "$tok" ] && { as_vendor="$tok"; break; }
  done <<< "$(providers_list)"
  if [ -n "$as_provider" ] && [ -n "$as_vendor" ] && [ "$as_provider" != "$as_vendor" ]; then
    return 2
  fi
  [ -n "$as_provider" ] && { printf '%s\n' "$as_provider"; return 0; }
  [ -n "$as_vendor" ] && { printf '%s\n' "$as_vendor"; return 0; }
  return 1
}
if [ "${#author_vendors[@]}" -gt 0 ]; then
  normalized_authors=()
  for av in "${author_vendors[@]}"; do
    [ -n "$av" ] || { echo "delegate-resolve: --author-vendor cannot be empty" >&2; exit 2; }
    nv="$(vendor_for_author_token "$av")"; tok_rc=$?   # this script runs without errexit
    case "$tok_rc" in
      2) echo "delegate-resolve: --author-vendor '$av' names both a provider (vendor '$(cat_val "providers.$av" vendor)') and a vendor: say which with --author-provider, or name the vendor that is not also a provider" >&2
         exit 2 ;;
      # An identity that names nothing excludes nobody, which would let a review look
      # independent while routing straight back to the author. Treat it as the typo it is.
      1) echo "delegate-resolve: --author-vendor '$av' names no vendor or provider in the catalog: it would exclude nothing" >&2
         exit 2 ;;
    esac
    normalized_authors+=("$nv")
  done
  author_vendors=("${normalized_authors[@]}")
fi
explicit_author_vendors=(${author_vendors[@]+"${author_vendors[@]}"})

for am in ${author_models[@]+"${author_models[@]}"}; do
  [ -n "$am" ] || { echo "delegate-resolve: --author-model cannot be empty" >&2; exit 2; }
  am_providers="$(providers_for_model "$am")"
  [ -n "$am_providers" ] || {
    echo "delegate-resolve: --author-model '$am' matches no model in any [providers.*] tier map or model key" >&2
    exit 2
  }
  # Open-weights models are reachable through more than one host, so one id can sit
  # under several providers. That is harmless while they share a vendor. Across
  # vendors the id no longer identifies an author: excluding the wrong one would let
  # the artifact's actual author be selected as its own reviewer, so refuse rather
  # than pick. --author-vendor is the unambiguous way to say it.
  am_vendors="$(printf '%s\n' "$am_providers" | vendors_of_providers)"
  if [ "$(printf '%s\n' "$am_vendors" | grep -c .)" -gt 1 ]; then
    echo "delegate-resolve: --author-model '$am' is declared by more than one vendor ($(printf '%s' "$am_vendors" | tr '\n' ' ')): it cannot identify the author, so pass --author-vendor instead" >&2
    exit 2
  fi
  author_vendors+=("$am_vendors")
  # One vendor reachable through two hosts leaves independence intact (either match
  # excludes the same vendor) but does NOT say which backend the caller is, so this
  # occurrence contributes all of them and the intersection decides.
  add_identity_set "$am_providers" "--author-model $am"
done
# An author may also name its provider outright. This still contributes that
# provider's VENDOR to the exclusion set, so disambiguating self-routing cannot
# weaken an independence role the way a bare provider name in --author-vendor would.
for ap in ${author_providers[@]+"${author_providers[@]}"}; do
  [ -n "$ap" ] || { echo "delegate-resolve: --author-provider cannot be empty" >&2; exit 2; }
  cat_exists "providers.$ap" || {
    echo "delegate-resolve: --author-provider '$ap' has no [providers.$ap] section" >&2
    exit 2
  }
  apv="$(cat_val "providers.$ap" vendor)"
  author_vendors+=("${apv:-$ap}")
  add_identity_set "$ap" "--author-provider $ap"
done

# A `self` role has exactly ONE caller, so the declared identity has to name exactly
# one provider. Each flag that was passed CONSTRAINS the answer rather than
# overriding the others: naming a provider disambiguates a shared model id precisely
# because that provider is one of the id's candidates, so the answer is their
# intersection. Precedence instead would silently discard whichever claim lost, and
# taking the first of an ambiguous set would route a self role to a sibling backend.
for eav in ${explicit_author_vendors[@]+"${explicit_author_vendors[@]}"}; do
  add_identity_set "$(
    while IFS= read -r p_; do
      [ -n "$p_" ] || continue
      # `vendor` is optional; a provider without one is identified by its own name,
      # exactly as vendors_of_providers and vendor_for_author_token treat it.
      pv_="$(cat_val "providers.$p_" vendor)"
      [ "${pv_:-$p_}" = "$eav" ] && printf '%s\n' "$p_"
    done <<< "$(providers_list)"
  )" "--author-vendor $eav"
done

# AUTHOR_VENDORS joins these with commas in a line-oriented format, and consumers
# split that field to recover the identities. A vendor whose name contains a comma is
# therefore unrepresentable: emitting it would hand a consumer two vendors that are
# not the one excluded, silently weakening a check meant to fail closed.
for av in ${author_vendors[@]+"${author_vendors[@]}"}; do
  case "$av" in
    *,*) echo "delegate-resolve: vendor '$av' contains a comma, which the AUTHOR_VENDORS field cannot represent: rename it in the catalog" >&2
         exit 2 ;;
  esac
done

# WHO IS RUNNING is a different question from WHO WROTE IT, and they coincide only for
# a self role. Reviewing another agent's work is the ordinary case: the author is
# excluded while the route lands on the caller, which is a native dispatch. Deriving
# nativeness from the author would mark the ARTIFACT's provider native and the running
# session foreign, then drop the session's own route when its CLI is missing. Caller
# identity never enters the exclusion set or the receipt: it says where work runs.
caller_declared=""; caller_conflict=""
caller_candidates=""; caller_sources=0
add_caller_set() {  # $1=providers this occurrence allows
  local set_; set_="$(dedupe_lines "$1")"
  [ -n "$set_" ] || return 0
  if [ "$caller_sources" -eq 0 ]; then
    caller_candidates="$set_"
  else
    caller_candidates="$(printf '%s\n' "$caller_candidates" | grep -Fxf <(printf '%s\n' "$set_"))"
  fi
  caller_sources=$((caller_sources + 1))
  [ -n "$(printf '%s\n' "$caller_candidates" | grep .)" ] || caller_conflict="yes"
}
for cm in ${caller_models[@]+"${caller_models[@]}"}; do
  [ -n "$cm" ] || { echo "delegate-resolve: --caller-model cannot be empty" >&2; exit 2; }
  cm_providers="$(providers_for_model "$cm")"
  [ -n "$cm_providers" ] || {
    echo "delegate-resolve: --caller-model '$cm' matches no model in any [providers.*] tier map or model key" >&2
    exit 2
  }
  add_caller_set "$cm_providers"
done
for cp in ${caller_providers[@]+"${caller_providers[@]}"}; do
  [ -n "$cp" ] || { echo "delegate-resolve: --caller-provider cannot be empty" >&2; exit 2; }
  cat_exists "providers.$cp" || {
    echo "delegate-resolve: --caller-provider '$cp' has no [providers.$cp] section" >&2
    exit 2
  }
  add_caller_set "$cp"
done
caller_candidates="$(dedupe_lines "$caller_candidates")"
if [ -n "$caller_conflict" ]; then
  echo "delegate-resolve: the declared caller identities share no provider, so they cannot describe one running session" >&2
  exit 2
fi
case "$(printf '%s\n' "$caller_candidates" | grep -c .)" in
  0) : ;;
  1) caller_declared="$caller_candidates" ;;
  *) echo "delegate-resolve: the declared caller identity names more than one provider ($(printf '%s' "$caller_candidates" | tr '\n' ' ')): name the running session's backend with --caller-provider" >&2
     exit 2 ;;
esac

self_candidates="$(dedupe_lines "$self_candidates")"
if [ -z "$self_identity_conflict" ]; then
  case "$(printf '%s\n' "$self_candidates" | grep -c .)" in
    0) : ;;                                 # no identity declared: [lead] answers
    1) self_provider="$self_candidates" ;;
    *) self_ambiguous="$(printf '%s' "$self_candidates" | tr '\n' ' ')" ;;
  esac
fi

# `self` keeps a role inside the caller's own vendor. Resolution order: the author
# the caller declared, then the catalog [lead] for a session that declared none.
# Returns 2 when the declared identity names more than one provider: falling back to
# [lead] there would silently route to a DIFFERENT backend than the one asking, which
# is exactly what `self` promises not to do.
# A self role's author IS its caller, so a declared caller constrains the answer here
# rather than overriding it: short-circuiting to the caller would route to one provider
# while recording another as the author, and would let a broken author identity through.
self_target() {
  [ -n "$self_identity_conflict" ] && return 3
  if [ -z "$self_provider" ] && [ -n "$self_ambiguous" ]; then return 2; fi
  if [ -n "$caller_declared" ] && [ -n "$self_provider" ] && [ "$caller_declared" != "$self_provider" ]; then
    return 4
  fi
  local t="${caller_declared:-${self_provider:-$(cat_val lead provider)}}"
  [ -n "$t" ] || return 1
  printf '%s\n' "$t"
}

# Every path that needs a self target goes through here, so the diagnostic and the
# exit code cannot drift between them. All of these are bad INPUT, never an
# unavailable route: reporting them as exit 3 would read as "no route", which callers
# are told to accept by saying the check did not run, so a typo would skip a review.
# Sets self_target_out rather than printing, because a caller would have to capture
# stdout in a command substitution and `exit` there would only kill that subshell.
resolve_self_target_or_die() {  # $1=role ; sets self_target_out, or exits 2
  local st
  self_target_out="$(self_target)"; st=$?
  [ "$st" -eq 0 ] && return 0
  case "$st" in
    4) echo "delegate-resolve: role '$1' routes to 'self', but the declared caller ('$caller_declared') is not the declared author ('$self_provider'): a self role runs where its author is, so these cannot differ" >&2 ;;
    3) echo "delegate-resolve: role '$1' routes to 'self', but the declared author identities ($self_declared) share no provider, so they cannot describe one caller" >&2 ;;
    2) echo "delegate-resolve: role '$1' routes to 'self', but the declared author identity names more than one provider ($self_ambiguous): name the caller's own backend with --author-provider" >&2 ;;
    *) echo "delegate-resolve: role '$1' routes to 'self' but no --author-model/--author-vendor was given and no [lead] provider is declared" >&2 ;;
  esac
  exit 2
}

# The provider the running session IS, which is what makes a route native, plus how
# we know. `native` asserts the resolved provider IS the caller; when nobody declared
# one that assertion rests on the [lead] default, and a session that is NOT the lead
# would run its own subagent against another vendor's model believing it was home.
# Sets globals rather than printing: a caller would have to capture stdout in a
# subshell, and the provenance would not survive it.
set_running_provider() {  # $1=1 when the role is self-routed
  if [ -n "$caller_declared" ]; then
    running_p="$caller_declared"; caller_provenance="declared"; return 0
  fi
  # For a self role the author IS the caller, so an author declaration is a caller one.
  if [ "$1" -eq 1 ] && [ -n "$self_provider" ]; then
    running_p="$self_provider"; caller_provenance="declared"; return 0
  fi
  running_p="$(cat_val lead provider)"; caller_provenance="assumed-lead"
}

# Reachability, shared by resolution and the --vendors probe. These two loops have
# drifted apart three times (self targeting, this CLI gate, self_target's status), so
# the half they must agree on lives in one place. Policy checks (capability, tier,
# effort, floor) stay per-loop on purpose: resolution treats a mismatch as fatal and
# the probe treats it as "not reachable", and collapsing that would change one of them.
# Distinct statuses so each caller applies its own policy to one shared judgement:
# resolution treats a missing section as fatal and tracks "disabled" for its exit-4
# contract, while the probes just skip. Returning a single boolean is what let these
# semantics get redefined per loop in the first place.
candidate_reachable() {  # $1=provider $2=running provider
  local p="$1" rp="$2" en bin              # 0 usable, 2 no section, 3 disabled, 4 CLI absent
  cat_exists "providers.$p" || return 2
  en="$(cat_val "providers.$p" enabled)"; en="${en:-true}"
  [ "$en" = "false" ] && return 3
  # `binary` is the CROSS-RUNTIME entry point, so it gates a cli dispatch only. A
  # candidate that IS the caller runs on the harness's own subagent surface, which is
  # present by definition; demanding its CLI would strand every BYO-model harness.
  [ -n "$rp" ] && [ "$p" = "$rp" ] && return 0
  bin="$(cat_val "providers.$p" binary)"
  if [ -n "$bin" ] && ! command -v "$bin" >/dev/null 2>&1; then return 4; fi
  return 0
}

# Can this provider actually SERVE the role: capability, tier, effort, ship floor.
# Shared by the --vendors probe and the ALTERNATES count, because "how many vendors
# could take over" is worthless if it counts providers the role would reject.
#
# Resolution does NOT call this. It applies the same rules with per-check policy: a
# missing tier mapping or an unsupported effort is fatal there, while a floor
# violation is a skip, and each carries its own message. Flattening that to one
# boolean would lose the distinction the exit map depends on. That makes this a drift
# boundary. delegate-resolve.test.sh pins resolution, --vendors and ALTERNATES to the
# same verdict for a CAPABILITY rejection, and pins the one place they disagree: a
# chain candidate with no model at the role's tier is fatal in resolution and merely
# skipped by the probes, so --vendors can report a vendor resolution refuses to use.
# That predates this helper and is not fixed here; changing it moves an exit code.
candidate_serves_role() {  # $1=provider $2=req $3=tier $4=effort $5=floor_tier_idx $6=floor_eff_idx $7=effort_scale
  local p="$1" req_="$2" tier_="$3" eff_="$4" fti="$5" fei="$6" escale="$7"
  local caps rc_ ptier peff pidx peidx
  if [ -n "$req_" ]; then
    caps="$(cat_array "providers.$p" capabilities)"
    while IFS= read -r rc_; do
      [ -n "$rc_" ] || continue
      list_has "$caps" "$rc_" || return 1
    done <<< "$req_"
  fi
  if [ -n "$tier_" ]; then
    [ -n "$(cat_val "providers.$p.tiers" "$tier_")" ] || return 1
    ptier="$tier_"
  else
    ptier="$(cat_val "providers.$p" default_tier)"
  fi
  if [ -n "$eff_" ]; then
    list_has "$(cat_array "providers.$p" efforts)" "$eff_" || return 1
    peff="$eff_"
  else
    peff="$(cat_val "providers.$p" effort)"
  fi
  if [ -n "$fti" ] && [ -n "$ptier" ]; then
    pidx="$(tier_index "$ptier")"
    { [ -n "$pidx" ] && [ "$pidx" -ge "$fti" ]; } || return 1
  fi
  if [ -n "$fei" ] && [ -n "$peff" ]; then
    peidx="$(printf '%s\n' "$escale" | grep -nx -- "$peff" | cut -d: -f1)"
    { [ -n "$peidx" ] && [ "$peidx" -ge "$fei" ]; } || return 1
  fi
  return 0
}

# Suspending the author exclusion for a role that is ALSO independence-bound would
# route a review straight back to its author. Every path that resolves a `self` role
# calls this first, so no resolver entry point can report such a role as usable.
# The one place that decides whether a role's `self` value is the sentinel. A catalog
# that already declares [providers.self] keeps that provider's meaning, and every path
# has to agree: a route that means one thing to resolution and another to --vendors or
# --check is worse than either reading on its own.
role_routes_self() {  # $1=role
  [ "$(section_val roles "$1")" = "self" ] || return 1
  cat_exists "providers.self" && return 1
  return 0
}
config_uses_self_sentinel() {
  local lr
  while IFS= read -r lr; do
    [ -n "$lr" ] || continue
    role_routes_self "$lr" && return 0
  done <<< "$(list_roles)"
  return 1
}

reject_self_independence() {  # $1=role
  role_routes_self "$1" || return 0
  [ -n "$(section_val independence "$1")" ] || return 0
  echo "delegate-resolve: role '$1' routes to 'self' but is [independence]-bound: staying in-vendor cannot satisfy an author-bound policy, so fix the config before dispatching" >&2
  exit 2
}

# --- --check mode ------------------------------------------------------------------
if [ "$check" -eq 1 ]; then
  errs=0
  note() { echo "delegate-resolve --check: $1" >&2; errs=$((errs+1)); }
  while IFS= read -r r; do
    [ -n "$r" ] || continue
    p="$(section_val roles "$r")"
    [ -n "$p" ] || continue
    # A `self` role has no static provider, so the schema checks below run against
    # the [lead] provider: the target for a session that declares no author.
    p_check="$p"
    if role_routes_self "$r"; then
      p_check="$(cat_val lead provider)"
      [ -n "$p_check" ] || note "role '$r' routes to 'self' but no [lead] provider is declared as its fallback"
      [ -z "$(section_val independence "$r")" ] || note "role '$r' is both 'self'-routed and [independence]-bound: staying in-vendor cannot satisfy an author-bound policy"
      [ -z "$(fallbacks_of "$r")" ] || note "role '$r' is 'self'-routed and cannot also declare [fallbacks]"
    fi
    [ -z "$p_check" ] || cat_exists "providers.$p_check" || note "role '$r' routes to missing provider '$p_check'"
    while IFS= read -r fp; do
      [ -n "$fp" ] || continue
      cat_exists "providers.$fp" || note "fallback for '$r' names missing provider '$fp'"
    done <<< "$(fallbacks_of "$r")"
    if section_exists role_tiers; then
      rt="$(section_val role_tiers "$r")"
      [ -n "$rt" ] || note "role '$r' has no [role_tiers] entry"
      [ -z "$rt" ] || list_has "$scale_list" "$rt" || note "role '$r' tier '$rt' not in [tiers] scale"
      if [ -n "$rt" ]; then
        while IFS= read -r rp; do
          [ -n "$rp" ] || continue
          [ -n "$(cat_val "providers.$rp.tiers" "$rt")" ] || note "provider '$rp' has no tier '$rt' required by role '$r'"
        done <<< "$(fallbacks_of "$r")"
        [ -n "$(fallbacks_of "$r")" ] || [ -z "$p_check" ] || [ -n "$(cat_val "providers.$p_check.tiers" "$rt")" ] || note "provider '$p_check' has no tier '$rt' required by role '$r'"
      fi
    fi
    if section_exists role_efforts; then
      re="$(section_val role_efforts "$r")"
      [ -n "$re" ] || note "role '$r' has no [role_efforts] entry"
      [ -z "$re" ] || list_has "$(cat_array efforts scale)" "$re" || note "role '$r' effort '$re' not in [efforts] scale"
      if [ -n "$re" ]; then
        rproviders="$(fallbacks_of "$r")"; [ -n "$rproviders" ] || rproviders="$p_check"
        while IFS= read -r rp; do
          [ -n "$rp" ] || continue
          list_has "$(cat_array "providers.$rp" efforts)" "$re" || note "provider '$rp' does not support effort '$re' required by role '$r'"
        done <<< "$rproviders"
      fi
    fi
    drv="$(section_val role_drivers "$r")"
    if [ -n "$drv" ]; then
      section_exists "drivers.$drv" || note "role '$r' names missing driver '$drv'"
      [ -n "$(section_val "drivers.$drv" binary)" ] || note "driver '$drv' has no binary"
    fi
  done <<< "$(list_roles)"
  # A model id declared by providers of two different vendors cannot identify an
  # author, so --author-model has to refuse it at resolution. Surface that here, where
  # the catalog is being edited, rather than only inside a review gate at dispatch.
  # A duplicate under ONE vendor is only a problem where a role routes to `self`,
  # which is the only thing that needs to know WHICH backend the caller is.
  # A role whose value is literally `self` is shadowed when a provider by that name
  # exists; report that separately from the sentinel actually being in play, or the
  # two conditions mask each other.
  has_raw_self=0
  while IFS= read -r sr; do
    [ -n "$sr" ] || continue
    [ "$(section_val roles "$sr")" = "self" ] && { has_raw_self=1; break; }
  done <<< "$(list_roles)"
  has_self_role=0
  config_uses_self_sentinel && has_self_role=1
  if [ "$has_raw_self" -eq 1 ] && cat_exists "providers.self"; then
    note "a [providers.self] section exists, so roles routing to 'self' mean THAT provider and the self-routing sentinel is unavailable in this config"
  fi
  if [ "$has_self_role" -eq 1 ] && ! section_exists independence; then
    note "roles route to 'self' but no [independence] table exists, so no role in this config can require a different-vendor reviewer"
  fi
  while IFS= read -r cm; do
    [ -n "$cm" ] || continue
    cmp_="$(providers_for_model "$cm")"
    cmv="$(printf '%s\n' "$cmp_" | vendors_of_providers)"
    if [ "$(printf '%s\n' "$cmv" | grep -c .)" -gt 1 ]; then
      note "model '$cm' is declared by more than one vendor ($(printf '%s' "$cmv" | tr '\n' ' ')): --author-model cannot identify an author with it"
    elif [ "$has_self_role" -eq 1 ] && [ "$(printf '%s\n' "$cmp_" | grep -c .)" -gt 1 ]; then
      note "model '$cm' is declared by more than one provider ($(printf '%s' "$cmp_" | tr '\n' ' ')): --author-model cannot pick a backend for a 'self'-routed role, so its caller must pass --author-provider"
    fi
  done <<< "$(
    while IFS= read -r cp; do
      [ -n "$cp" ] || continue
      cat_val "providers.$cp" model
      while IFS= read -r ct; do
        [ -n "$ct" ] || continue
        cat_val "providers.$cp.tiers" "$ct"
      done <<< "$scale_list"
    done <<< "$(providers_list)" | grep . | awk '!seen[$0]++'
  )"
  # A vendor name with a comma cannot survive the AUTHOR_VENDORS encoding, so it
  # would break identity recovery for every consumer of a resolved route.
  while IFS= read -r cvp; do
    [ -n "$cvp" ] || continue
    # A vendorless provider is identified by its own name, so that is the value the
    # field would have to carry: check the EFFECTIVE vendor, as the helpers do.
    cvv="$(cat_val "providers.$cvp" vendor)"
    case "${cvv:-$cvp}" in
      *,*) note "provider '$cvp' effective vendor '${cvv:-$cvp}' contains a comma, which the AUTHOR_VENDORS field cannot represent" ;;
    esac
  done <<< "$(providers_list)"
  lp="$(cat_val lead provider)"
  if [ -n "$lp" ] && ! cat_exists "providers.$lp"; then note "[lead] provider '$lp' missing"; fi
  if [ -n "$lp" ] && cat_exists "providers.$lp"; then
    ltc="$(cat_val lead tier)"
    if [ -n "$ltc" ] && [ -z "$(cat_val "providers.$lp.tiers" "$ltc")" ]; then
      note "[lead] tier '$ltc' has no [providers.$lp.tiers] entry"
    fi
  fi
  fl="$(cat_val defaults floor)"
  if [ -n "$fl" ] && [ -n "$scale_list" ]; then
    ft="${fl%%:*}"
    list_has "$scale_list" "$ft" || note "floor tier '$ft' not in [tiers] scale"
  fi
  ce_scale="$(cat_array efforts scale)"
  if [ -n "$fl" ] && [ -n "$ce_scale" ]; then
    fe="${fl#*:}"
    if [ "$fe" != "$fl" ] && [ -n "$fe" ]; then
      list_has "$ce_scale" "$fe" || note "floor effort '$fe' not in [efforts] scale"
    fi
  fi
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    dt="$(cat_val "providers.$p" default_tier)"
    if [ -n "$dt" ]; then
      [ -n "$(cat_val "providers.$p.tiers" "$dt")" ] || note "provider '$p' default_tier '$dt' has no tier-map entry"
      if [ -n "$scale_list" ]; then
        list_has "$scale_list" "$dt" || note "provider '$p' default_tier '$dt' not in [tiers] scale"
      fi
    fi
    ref="$(cat_val "providers.$p" reference)"
    if [ -n "$ref" ] && [ ! -f "$here/../$ref" ]; then note "provider '$p' reference file missing: $ref"; fi
    pe="$(cat_val "providers.$p" effort)"
    plist="$(cat_array "providers.$p" efforts)"
    if [ -n "$pe" ] && [ -n "$ce_scale" ]; then
      list_has "$ce_scale" "$pe" || note "provider '$p' default effort '$pe' not in [efforts] scale"
    fi
    if [ -n "$pe" ] && [ -n "$plist" ]; then
      list_has "$plist" "$pe" || note "provider '$p' default effort '$pe' not in its efforts list"
    fi
    if [ -n "$plist" ] && [ -n "$ce_scale" ]; then
      while IFS= read -r pev; do
        [ -n "$pev" ] || continue
        list_has "$ce_scale" "$pev" || note "provider '$p' efforts entry '$pev' not in [efforts] scale"
      done <<< "$plist"
    fi
  done <<< "$(providers_list)"
  if [ "$errs" -eq 0 ]; then echo "delegate-resolve --check: OK (${layers[*]}${mlayers[*]:+ + ${mlayers[*]}})"; exit 0; fi
  exit 1
fi

# --- list / preset modes ---------------------------------------------------------
if [ "$list" -eq 1 ]; then list_roles; exit 0; fi
if [ "$list_presets" -eq 1 ]; then list_preset_names; exit 0; fi

# --vendors: distinct vendors reachable right now, one per line.
#
# Callers use the COUNT to decide whether vendor independence is achievable: with
# fewer than two, some author vendor leaves no route away from itself, so demanding
# an independent review is futile rather than merely inconvenient.
#
# WITH a role, the probe walks that role's candidate chain and applies the same
# filters resolution does. Without one it reports every reachable provider, which
# is a strictly weaker claim: a globally reachable vendor that the role does not
# route to, or that fails its capability/tier/effort/floor requirements, cannot
# serve the role. Anything deciding whether an independent review can resolve must
# pass the role, or it will count vendors that resolution would reject.
if [ "$vendors" -eq 1 ]; then
  if [ -n "$role" ]; then
    vr_primary="$(section_val roles "$role")"
    [ -n "$vr_primary" ] || { echo "delegate-resolve: no route for role '$role'" >&2; exit 3; }
    vr_role_is_self=0
    if role_routes_self "$role"; then
      vr_role_is_self=1
      reject_self_independence "$role"
      # A self role reaches exactly one vendor by construction: the caller's own.
      resolve_self_target_or_die "$role"; vr_primary="$self_target_out"
      vr_candidates="$vr_primary"
    else
      vr_candidates="$(fallbacks_of "$role")"
      [ -n "$vr_candidates" ] || vr_candidates="$vr_primary"
    fi
    vr_tier="$(section_val role_tiers "$role")"
    vr_effort="$(section_val role_efforts "$role")"
    vr_req="$(array_val requires "$role")"
    vr_floor="$(cat_val defaults floor)"
    vr_scale="$scale_list"
    vr_eff_scale="$(cat_array efforts scale)"
    set_running_provider "$vr_role_is_self"; vr_running_p="$running_p"
    vr_floor_idx=""; vr_floor_eff_idx=""
    if [ -n "$vr_floor" ] && [ -n "$vr_scale" ]; then
      vr_floor_idx="$(tier_index "${vr_floor%%:*}")"
    fi
    if [ -n "$vr_floor" ]; then
      vr_fe="${vr_floor#*:}"
      if [ "$vr_fe" != "$vr_floor" ] && [ -n "$vr_fe" ] && [ -n "$vr_eff_scale" ]; then
        vr_floor_eff_idx="$(printf '%s\n' "$vr_eff_scale" | grep -nx -- "$vr_fe" | cut -d: -f1)"
      fi
    fi
    while IFS= read -r p; do
      [ -n "$p" ] || continue
      # Exactly the reachability resolution uses, from one definition: this probe
      # decides whether a review can happen at all, so a route that resolves must not
      # disappear here, and one that cannot resolve must not be counted.
      candidate_reachable "$p" "$vr_running_p" || continue
      candidate_serves_role "$p" "$vr_req" "$vr_tier" "$vr_effort" \
        "$vr_floor_idx" "$vr_floor_eff_idx" "$vr_eff_scale" || continue
      v="$(cat_val "providers.$p" vendor)"
      [ -n "$v" ] && printf '%s\n' "$v"
    done <<< "$vr_candidates" | awk '!seen[$0]++'
    exit 0
  fi
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    en="$(cat_val "providers.$p" enabled)"; en="${en:-true}"
    [ "$en" = "false" ] && continue
    bin="$(cat_val "providers.$p" binary)"
    if [ -n "$bin" ] && ! command -v "$bin" >/dev/null 2>&1; then continue; fi
    v="$(cat_val "providers.$p" vendor)"
    [ -n "$v" ] && printf '%s\n' "$v"
  done <<< "$(providers_list)" | awk '!seen[$0]++'
  exit 0
fi

if [ "$lead" -eq 1 ]; then
  lp="$(cat_val lead provider)"
  [ -n "$lp" ] || { echo "delegate-resolve: no [lead] section in ${layers[*]}" >&2; exit 3; }
  cat_exists "providers.$lp" || { echo "delegate-resolve: [lead] provider '$lp' has no [providers.$lp] section" >&2; exit 2; }
  lt="$(cat_val lead tier)"
  if [ -n "$lt" ]; then
    lm="$(cat_val "providers.$lp.tiers" "$lt")"
    if [ -z "$lm" ]; then
      echo "delegate-resolve: [lead] tier '$lt' has no [providers.$lp.tiers] entry" >&2
      exit 2
    fi
  else
    pm="$(provider_model "$lp")" || exit 2
    lm="${pm%%$'\t'*}"; lt="${pm#*$'\t'}"
  fi
  echo "LEAD_PROVIDER=$lp"
  [ -n "$lt" ] && echo "LEAD_TIER=$lt"
  echo "LEAD_MODEL=${lm:-}"
  lv="$(cat_val "providers.$lp" vendor)"
  [ -n "$lv" ] && echo "LEAD_VENDOR=$lv"
  exit 0
fi

if [ -n "$preset" ]; then
  if ! section_exists "presets.$preset"; then
    echo "delegate-resolve: no preset '$preset' in ${layers[*]}" >&2
    echo "presets available:" >&2; list_preset_names | sed 's/^/  /' >&2
    exit 3
  fi
  echo "PRESET=$preset"
  for k in sandbox approval worktree cap use; do
    v="$(section_val "presets.$preset" "$k")"
    [ -n "$v" ] && echo "$(printf '%s' "$k" | tr '[:lower:]' '[:upper:]')=$v"
  done
  exit 0
fi

[ -n "$role" ] || { usage; exit 2; }

if [ "$exclude_lead" -eq 1 ]; then
  lp="$(cat_val lead provider)"
  if [ -n "$lp" ]; then
    excludes+=("$lp")
    lv="$(cat_val "providers.$lp" vendor)"
    [ -n "$lv" ] && excludes+=("$lv")
  fi
fi

# --- role resolution -------------------------------------------------------------
primary="$(section_val roles "$role")"
if [ -z "$primary" ]; then
  echo "delegate-resolve: no route for role '$role' in ${layers[*]}" >&2
  echo "roles available:" >&2
  list_roles | sed 's/^/  /' >&2
  exit 3
fi

# A `self` role stays in the caller's own vendor. This is the default for work with
# no independence requirement: leaving the vendor there buys nothing and spends a
# third-party call. Roles that DO carry an [independence] policy keep their chains.
# `self` is a sentinel, but a config that already declares a provider by that name
# keeps its original meaning: reinterpreting an existing route would silently send it
# somewhere else. --check reports the collision so the author knows the sentinel is
# unavailable in that catalog.
role_is_self=0
if role_routes_self "$role"; then
  reject_self_independence "$role"
  role_is_self=1
  resolve_self_target_or_die "$role"; primary="$self_target_out"
fi

# Schema v2 role policy selects the tier and effort for this work. A config
# that declares either policy table must cover every role it routes, otherwise
# a missing key would silently fall back to an unrelated provider default.
role_tier="$(section_val role_tiers "$role")"
if section_exists role_tiers && [ -z "$role_tier" ]; then
  echo "delegate-resolve: role '$role' has no [role_tiers] entry" >&2
  exit 2
fi
role_effort="$(section_val role_efforts "$role")"
if section_exists role_efforts && [ -z "$role_effort" ]; then
  echo "delegate-resolve: role '$role' has no [role_efforts] entry" >&2
  exit 2
fi
if [ -n "$role_tier" ]; then
  [ -n "$scale_list" ] || { echo "delegate-resolve: role '$role' declares tier '$role_tier' without a [tiers] scale" >&2; exit 2; }
  list_has "$scale_list" "$role_tier" || {
    echo "delegate-resolve: role '$role' tier '$role_tier' is not in the [tiers] scale" >&2
    exit 2
  }
fi
effort_scale="$(cat_array efforts scale)"
if [ -n "$role_effort" ]; then
  [ -n "$effort_scale" ] || { echo "delegate-resolve: role '$role' declares effort '$role_effort' without an [efforts] scale" >&2; exit 2; }
  list_has "$effort_scale" "$role_effort" || {
    echo "delegate-resolve: role '$role' effort '$role_effort' is not in the [efforts] scale" >&2
    exit 2
  }
fi

# Independence is relative to the artifact authors, never merely to the
# catalog lead. `--exclude-lead` remains available for compatibility, but it
# cannot satisfy an author-bound policy.
independence="$(section_val independence "$role")"
if [ -n "$independence" ] && [ "${#author_vendors[@]}" -eq 0 ]; then
  echo "delegate-resolve: independent role '$role' requires --author-vendor <vendor>" >&2
  exit 2
fi
# Author exclusion is what [independence] asks for, and only that. Every harness is
# told to declare who it is on every call so routing can tell a native dispatch from
# a cross-runtime one, so identifying yourself must not quietly cost you your own
# vendor on a role that never demanded a second opinion. `--exclude` remains the
# policy-free way to drop a backend.
#
# A config with NO [independence] table at all predates that table, and its author
# exclusion was unconditional. Keep it that way: reading a missing policy as "no
# policy" would silently weaken independence on exactly the configs that cannot say
# they wanted it. Using the `self` sentinel anywhere proves a config is NOT one of
# those, so there a missing table means what it says: no role declares independence.
apply_author_exclusion=0
if [ "$role_is_self" -eq 0 ]; then
  if [ -n "$independence" ]; then
    apply_author_exclusion=1
  elif ! section_exists independence && ! config_uses_self_sentinel; then
    apply_author_exclusion=1
  fi
fi
if [ "$apply_author_exclusion" -eq 1 ] && [ "${#author_vendors[@]}" -gt 0 ]; then
  for av in "${author_vendors[@]}"; do
    [ -n "$av" ] || { echo "delegate-resolve: --author-vendor cannot be empty" >&2; exit 2; }
    excludes+=("$av")
  done
fi

# A driver captures evidence for a model role. It is a separate executable,
# not a provider, and therefore never satisfies vendor, tier, or floor checks.
driver="$(section_val role_drivers "$role")"
driver_binary=""
driver_channel=""
if [ -n "$driver" ]; then
  section_exists "drivers.$driver" || {
    echo "delegate-resolve: role '$role' names missing driver '$driver'" >&2
    exit 2
  }
  driver_binary="$(section_val "drivers.$driver" binary)"
  driver_channel="$(section_val "drivers.$driver" channel)"
  [ -n "$driver_binary" ] || {
    echo "delegate-resolve: driver '$driver' has no binary" >&2
    exit 2
  }
  command -v "$driver_binary" >/dev/null 2>&1 || {
    echo "delegate-resolve: driver '$driver' binary '$driver_binary' is not installed" >&2
    exit 3
  }
fi

# candidate chain: the role's [fallbacks] (in order) or just its single provider.
# A self role has no chain by definition: the caller's own provider or nothing.
if [ "$role_is_self" -eq 1 ]; then
  candidates="$primary"
else
  candidates="$(fallbacks_of "$role")"
  [ -n "$candidates" ] || candidates="$primary"
fi

# a candidate is excluded when its provider name OR its vendor is in --exclude.
excluded() {  # $1=provider
  local p="$1" v x; v="$(cat_val "providers.$p" vendor)"
  [ "${#excludes[@]}" -gt 0 ] || return 1
  for x in "${excludes[@]}"; do
    [ "$x" = "$p" ] && return 0
    [ -n "$v" ] && [ "$x" = "$v" ] && return 0
  done
  return 1
}

floor="$(cat_val defaults floor)"
floor_idx=""
if [ -n "$floor" ] && [ -n "$scale_list" ]; then
  ftier="${floor%%:*}"
  floor_idx="$(tier_index "$ftier")"
  if [ -z "$floor_idx" ]; then
    echo "delegate-resolve: floor tier '$ftier' is not in the [tiers] scale" >&2
    exit 2
  fi
fi
# The floor's effort half validates against the [efforts] scale.
floor_effort_idx=""
if [ -n "$floor" ]; then
  feff="${floor#*:}"
  if [ "$feff" != "$floor" ] && [ -n "$feff" ]; then
    if [ -n "$effort_scale" ] && ! list_has "$effort_scale" "$feff"; then
      echo "delegate-resolve: floor effort '$feff' is not in the [efforts] scale" >&2
      exit 2
    fi
    [ -n "$effort_scale" ] && floor_effort_idx="$(printf '%s\n' "$effort_scale" | grep -nx -- "$feff" | cut -d: -f1)"
  fi
fi
req="$(array_val requires "$role")"

set_running_provider "$role_is_self"
selected=""; selected_model=""; selected_tier=""; selected_effort=""; selected_native=0; only_disabled=1
while IFS= read -r p; do
  [ -n "$p" ] || continue
  # One judgement, this loop's policy. A missing section is fatal here and merely
  # skipped by the probes; "disabled" has to stay distinguishable to keep the exit-4
  # single-route contract, which is exactly what a boolean would have flattened.
  #
  # Status 2 is handled BEFORE exclusion on purpose: a routed provider that has no
  # section is a broken table whether or not this call happens to exclude it, and
  # checking exclusion first would make that fatal depend on who the author is.
  candidate_reachable "$p" "$running_p"; reach_st=$?
  if [ "$reach_st" -eq 2 ]; then
    echo "delegate-resolve: role '$role' routes to provider '$p', but no [providers.$p] section exists in ${layers[*]}" >&2
    exit 2
  fi
  if excluded "$p"; then only_disabled=0; continue; fi
  [ "$reach_st" -eq 3 ] && continue                  # disabled -> only_disabled stays set
  only_disabled=0
  [ "$reach_st" -eq 0 ] || continue                  # absent CLI on a cli route -> next
  candidate_native=0
  if [ -n "$running_p" ] && [ "$p" = "$running_p" ]; then candidate_native=1; fi
  if [ -n "$req" ]; then
    caps="$(cat_array "providers.$p" capabilities)"
    capmiss=0
    while IFS= read -r rc_; do
      [ -n "$rc_" ] || continue
      list_has "$caps" "$rc_" || { capmiss=1; break; }
    done <<< "$req"
    if [ "$capmiss" -eq 1 ]; then
      echo "delegate-resolve: provider '$p' lacks a required capability for role '$role' (skipped)" >&2
      continue
    fi
  fi
  if [ -n "$role_tier" ]; then
    candidate_tier="$role_tier"
    candidate_model="$(cat_val "providers.$p.tiers" "$candidate_tier")"
    if [ -z "$candidate_model" ]; then
      echo "delegate-resolve: provider '$p' has no model mapping for role '$role' tier '$candidate_tier'" >&2
      exit 2
    fi
  else
    pm="$(provider_model "$p")" || exit 2
    candidate_model="${pm%%$'\t'*}"
    candidate_tier="${pm#*$'\t'}"
  fi
  candidate_effort="${role_effort:-$(cat_val "providers.$p" effort)}"
  if [ -n "$role_effort" ]; then
    supported_efforts="$(cat_array "providers.$p" efforts)"
    if [ -z "$supported_efforts" ] || ! list_has "$supported_efforts" "$role_effort"; then
      echo "delegate-resolve: provider '$p' does not support role '$role' effort '$role_effort'" >&2
      exit 2
    fi
  fi
  if [ -n "$floor_idx" ]; then
    if [ -z "$candidate_tier" ]; then
      if [ -n "$role_tier" ]; then
        echo "delegate-resolve: provider '$p' has no tier and cannot satisfy floor '${floor%%:*}'" >&2
        exit 2
      fi
    else
      pidx="$(tier_index "$candidate_tier")"
      if [ -z "$pidx" ]; then
        echo "delegate-resolve: provider '$p' tier '$candidate_tier' is not in the [tiers] scale" >&2
        exit 2
      fi
      if [ "$pidx" -lt "$floor_idx" ]; then
        echo "delegate-resolve: provider '$p' tier '$candidate_tier' is below floor '${floor%%:*}' (skipped)" >&2
        continue
      fi
    fi
  fi
  if [ -n "$floor_effort_idx" ]; then
    if [ -z "$candidate_effort" ]; then
      if [ -n "$role_effort" ]; then
        echo "delegate-resolve: provider '$p' has no effort and cannot satisfy floor '${floor#*:}'" >&2
        exit 2
      fi
    else
      peff_idx="$(printf '%s\n' "$effort_scale" | grep -nx -- "$candidate_effort" | cut -d: -f1)"
      if [ -z "$peff_idx" ]; then
        echo "delegate-resolve: provider '$p' effort '$candidate_effort' is not in the [efforts] scale" >&2
        exit 2
      fi
      if [ "$peff_idx" -lt "$floor_effort_idx" ]; then
        echo "delegate-resolve: provider '$p' effort '$candidate_effort' is below floor '${floor#*:}' (skipped)" >&2
        continue
      fi
    fi
  fi
  selected="$p"
  selected_model="$candidate_model"
  selected_tier="$candidate_tier"
  selected_effort="$candidate_effort"
  selected_native="$candidate_native"
  break
done <<< "$candidates"

if [ -z "$selected" ]; then
  # nothing usable: distinguish "the one provider is switched off" (exit 4) from
  # "everything was excluded, disabled along a chain, or its CLI is absent"
  # (exit 3). Exit 4 is a single-route contract, so a multi-candidate chain
  # never takes it, even when every candidate is disabled.
  n_cand="$(printf '%s\n' "$candidates" | grep -c .)"
  if [ "$only_disabled" -eq 1 ] && [ "$n_cand" -eq 1 ]; then
    sole="$(printf '%s\n' "$candidates" | grep -m1 .)"
    echo "ROLE=$role"
    echo "PROVIDER=$sole"
    pm="$(provider_model "$sole")" || exit 2
    dmodel="${pm%%$'\t'*}"; dtier="${pm#*$'\t'}"
    echo "MODEL=${dmodel:-}"
    [ -n "$dtier" ] && echo "TIER=$dtier"
    ef="$(cat_val "providers.$sole" effort)"
    [ -n "$ef" ] && echo "EFFORT=$ef"
    echo "CHANNEL=$(cat_val "providers.$sole" channel)"
    echo "ENABLED=false"
    [ -n "$floor" ] && echo "FLOOR=$floor"
    echo "delegate-resolve: provider '$sole' for role '$role' is DISABLED in config: enable it or re-route the role before dispatching." >&2
    exit 4
  fi
  echo "delegate-resolve: no available route for role '$role': every candidate is excluded, disabled, or its CLI is not installed." >&2
  echo "candidates tried: $(printf '%s' "$candidates" | tr '\n' ' ')" >&2
  exit 3
fi

# --- emit the resolved route -----------------------------------------------------
model="$selected_model"
tier="$selected_tier"
effort="$selected_effort"
channel="$(cat_val "providers.$selected" channel)"
vendor="$(cat_val "providers.$selected" vendor)"
binv="$(cat_val "providers.$selected" binary)"
notes="$(cat_val "providers.$selected" notes)"

# How to reach the resolved provider, which is not the same question as which
# provider it is. When the route lands on the CALLER's own provider, the harness
# already has a first-class way to run this work (subagent, team, workflow); calling
# your own CLI would spawn a cold session, drop the context that made delegating
# worthwhile, and pay twice for it. CHANNEL/BINARY describe the cross-runtime path
# and apply only when DISPATCH=cli.
dispatch="cli"
[ "$selected_native" -eq 1 ] && dispatch="native"

# How many OTHER vendors could still serve an independence role once the authors are
# excluded. One means the next outage takes independent review with it, and a caller
# only learns that from a probe it has no reason to run. Say it on the route instead.
alternates=""
if [ -n "$independence" ]; then
  # Same eligibility the probe applies. Counting a provider the role would reject
  # would overstate the number of vendors that could actually take over, which is the
  # one thing this field exists to report honestly.
  alt_floor_eff_idx=""
  if [ -n "$floor" ] && [ -n "$effort_scale" ]; then
    alt_fe="${floor#*:}"
    [ "$alt_fe" != "$floor" ] && [ -n "$alt_fe" ] &&
      alt_floor_eff_idx="$(printf '%s\n' "$effort_scale" | grep -nx -- "$alt_fe" | cut -d: -f1)"
  fi
  alternates="$(
    while IFS= read -r ap_; do
      [ -n "$ap_" ] || continue
      excluded "$ap_" && continue
      candidate_reachable "$ap_" "$running_p" || continue
      candidate_serves_role "$ap_" "$req" "$role_tier" "$role_effort" \
        "$floor_idx" "$alt_floor_eff_idx" "$effort_scale" || continue
      av_="$(cat_val "providers.$ap_" vendor)"
      printf '%s\n' "${av_:-$ap_}"
    done <<< "$candidates" | awk '!seen[$0]++' | grep -c .
  )"
fi

echo "ROLE=$role"
echo "PROVIDER=$selected"
echo "DISPATCH=$dispatch"
echo "CALLER=$caller_provenance"
echo "MODEL=${model:-}"
[ -n "$tier" ] && echo "TIER=$tier"
[ -n "$effort" ] && echo "EFFORT=$effort"
echo "CHANNEL=${channel:-}"
echo "ENABLED=true"
[ -n "$vendor" ] && echo "VENDOR=$vendor"
[ -n "$binv" ] && echo "BINARY=$binv"
[ -n "$floor" ] && echo "FLOOR=$floor"
[ -n "$alternates" ] && echo "ALTERNATES=$alternates"
# Repeated fields are authoritative: a consumer recovers each identity without parsing
# a delimiter, so a vendor name can never be split or a blank component hidden by it.
# The joined field stays for consumers written against the older contract.
for av_out in ${author_vendors[@]+"${author_vendors[@]}"}; do echo "AUTHOR_VENDOR=$av_out"; done
[ "${#author_vendors[@]}" -gt 0 ] && echo "AUTHOR_VENDORS=$(IFS=,; printf '%s' "${author_vendors[*]}")"
[ -n "$driver" ] && echo "DRIVER=$driver"
[ -n "$driver_binary" ] && echo "DRIVER_BINARY=$driver_binary"
[ -n "$driver_channel" ] && echo "DRIVER_CHANNEL=$driver_channel"
[ -n "$notes" ] && echo "NOTES=$notes"
# `native` tells a session to run the work on its own subagent surface. If nobody
# declared a caller that rests on the [lead] default, and a session that is not the
# lead would do exactly that against another vendor's model, believing it was home.
if [ "$dispatch" = "native" ] && [ "$caller_provenance" = "assumed-lead" ]; then
  echo "delegate-resolve: no caller declared, so 'native' assumes this session is the [lead] provider '$selected'; pass --caller-model if it is not" >&2
fi
exit 0   # explicit: the last `[ -n ... ] && echo` returns 1 when a field is empty
