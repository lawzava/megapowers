#!/usr/bin/env bash
# session-metrics: turn "sessions feel slow" into a number.
#
#   scripts/session-metrics [--since ISO8601] [--project DIR] [--json] [--include-all] [--rules]
#
# Reads Claude Code transcripts (~/.claude/projects/<slug>/<session-uuid>.jsonl,
# JSON Lines) and reports, per session and pooled across sessions: span,
# assistant turns, model latency (median, p90, total), tool wall clock by
# tool, Bash p90, the batched-tool-call ratio, the backgrounded-Bash ratio,
# skill invocations, and hook failures. This is a report, not a gate: it
# exits 0 whenever it can read the transcript store, and never writes
# anything under the store.
#
# --since ISO8601   only include sessions whose last matched record is at or
#                    after this timestamp.
# --project DIR      only scan the transcript directory for this working
#                    directory (matched by the same slugification Claude Code
#                    uses: every non-alphanumeric character becomes '-').
# --json             machine-readable output instead of the text report.
# --include-all      also include sidechain sessions and non-cli entrypoint
#                    sessions (SDK spawns), which are excluded by default so
#                    they do not distort the aggregate. Subagent transcripts
#                    are sidechains, so this is the flag that brings them in.
# --rules            report on the enforcement lifecycle instead of session
#                    performance: advisory honor rate, Stop-hook gate fires and
#                    where they land, verify rounds reached, and delegate-run
#                    wall clock. Combines with every flag above. These are the
#                    numbers that decide whether an advisory rule earns
#                    promotion and whether an enforced one is firing on work it
#                    should not, so they belong in the same instrument as the
#                    latency numbers rather than in a one-off audit script.
#
# Transcript root defaults to $HOME/.claude/projects; override with
# SESSION_METRICS_ROOT (tests point this at a fixture directory).
#
# Discovery walks a project slug directory to the bottom, not just its top
# level. Since the harness started writing subagent transcripts to
# <slug>/<session-uuid>/subagents/**, more than half the files in this author's
# store sit below the top level (688 against 628), holding 36 hook_blocking_error
# records and 33 delegate-run round lines that no flag could reach. Those files
# are ordinary transcripts and every one of them declares isSidechain true, so
# the exclusion contract above still decides what counts: they stay out of the
# default report, which is unchanged by the wider walk, and arrive with
# --include-all like any other sidechain. They are additive rather than
# duplicates, because a parent transcript carries no isSidechain records of its
# own. Workflow journals (<...>/subagents/workflows/*/journal.jsonl) live in the
# same tree and carry no timestamped records, so they contribute nothing.
#
# entrypoint and isSidechain are session-level properties that only appear on
# some records within a file. Each session's value is resolved once, from
# whichever record in the file carries it (default "cli" and "false" when no
# record carries it), and the whole session is included or excluded on that
# basis. Filtering record by record would keep the records that happen to
# lack the field while dropping the ones that carry it, leaving a phantom
# partial session behind instead of excluding it entirely.
#
# A session with zero assistant turns after filtering is omitted rather than
# printed as a row of "n/a": it carries no information.
#
# Claude Code does not write one record per model response. It splits a single
# response into one record per content block (each thinking block, the text
# block, and every tool_use block gets its own record), and the sibling records
# all carry the same message.id. So a type=="assistant" record is a block, not a
# turn, and counting records overstates model responses by more than a factor of
# two (42575 records against 19580 responses over this author's own store).
# Anything that means "per model response" therefore groups assistant records by
# message.id first. Sibling records are always adjacent in the assistant
# subsequence and always in timestamp order, so a group is a contiguous run.
#
# Metric definitions:
#
# - Assistant turns: count of model responses, i.e. groups of consecutive
#   assistant records sharing a message.id. A record with no message.id is its
#   own group (the conservative reading: never merge records that might belong
#   to different responses).
# - Model latency: for each model response, the gap between the timestamp of
#   the last type=="user" record preceding it and the timestamp of its first
#   record. The preceding user record is the tool_result or human prompt that
#   completed the model's input, so this is composing time up to the first
#   streamed block, and it excludes tool execution. When no user record
#   separates a response from the one before it, the previous response's last
#   record is used instead; a negative gap (sub-second record write-order
#   jitter) is treated as zero.
# - Tool wall clock: for each tool_use block, the gap between its parent
#   assistant record's timestamp and the timestamp of the matching
#   tool_result (paired by id). A gap at or above one hour (GAP_CAP_SECONDS
#   below) is treated as an approval-wait or session-idle artifact rather
#   than execution time, since no synchronous tool call legitimately runs
#   that long, and is excluded from the wall-clock total and the Bash p90;
#   the excluded count is still reported so nothing is silently dropped.
# - Batched-tool-call ratio: model responses issuing more than one tool_use
#   block, over model responses issuing at least one. The blocks are summed
#   across the response's records, since one response normally spreads its
#   tool_use blocks over several records.
# - Backgrounded-Bash ratio: Bash tool_use blocks with
#   input.run_in_background true, over all Bash tool_use blocks.
# - Hook failures: attachment records whose attachment.durationMs is present
#   and whose payload carries a non-zero exitCode or the text "Plugin
#   directory does not exist".
#
# --rules metric definitions:
#
# - Advisory honor rate: for every [rules.*] whose `state` is "advisory" in the
#   layered enforcement contract (the measured project's
#   .megapowers/enforcement.toml, then
#   ${XDG_CONFIG_HOME:-~/.config}/megapowers/enforcement.toml, then the copy
#   shipped at plugins/megapowers/enforcement.toml, merged per key). The project
#   layer is read from the --project directory when one is given and from the
#   current directory otherwise: measuring one repository against another
#   repository's fire_prefix and honor_window is a wrong answer with no symptom.
#   A fire is one occurrence of the rule's `fire_prefix` inside an attachment
#   record whose attachment.type is "hook_additional_context", which is the only
#   record shape that is an actual hook delivery, and the skill it names is the
#   token right after the prefix. A fire is honored when one of the next
#   `honor_window` assistant records carries a Skill tool_use for that skill,
#   compared after stripping the plugin prefix from input.skill so "megapowers:x"
#   matches "x". The window counts assistant records (content blocks), which is
#   the unit honor_window is stated in and runs three to four blocks per model
#   response.
# - Advisory echoes: occurrences of the same `fire_prefix` in every other record
#   shape, reported beside the fires and never counted as one. Greps of the
#   hook's source, task briefs quoting it, tool_results carrying enforcement.toml,
#   and the model repeating the line back all print the literal, and on this
#   author's store they outnumbered the deliveries four to one: counting them put
#   the honor rate at 22% against a real 100%, worst in the repository that owns
#   the rule, because auditing it inflated its own denominator. They are reported
#   rather than dropped so that a harness which renames the delivery shape shows
#   up as zero fires against a high echo count instead of as silence.
# - Gate fires: attachment records whose attachment.type is
#   "hook_blocking_error" and whose hookEvent is "Stop", one per Stop-hook
#   block. The system/stop_hook_summary record the harness writes alongside is a
#   second view of the same block and is deliberately not counted. Each block is
#   attributed to a rule by the opening words of its reason (the transcript
#   carries the reason, not the rule name) and to a project by the record's cwd.
#   The distribution is the whole point: 47 of the audit's 141 blocks landed in
#   this repository, which ships markdown and shell and no auth or billing code,
#   and a gate concentrated in one repository is a gate with a false-positive
#   problem rather than a repository with a risk problem.
# - Verify rounds: the "consecutive dispatch N of role 'ROLE' on 'BRANCH'
#   without an approve" line delegate-run prints, parsed out of tool_result
#   records whose tool_use_id belongs to a Bash tool_use. Restricting to Bash
#   results is what keeps a Read or a grep of delegate-run's own source out of
#   the count. Reported as the distribution of N, the maximum, and the maximum
#   per (role, branch) pair, because a single pair climbing is the shape that
#   matters: the audit found round 11 on a feature branch and round 22 on a
#   repository branch, with nothing capping either.
# - delegate-run wall clock: Bash tool_use blocks whose input.command contains
#   "delegate-run", paired with their tool_result by id, under the same
#   GAP_CAP_SECONDS exclusion as tool wall clock above. Reported as
#   invocations, measured total, median, p90, and the count whose result text
#   contains "did not complete within its", i.e. the calls that hit the
#   harness's foreground Bash cap and were moved to the background. Those last
#   ones are the expensive failure: the session declared a timeout the harness
#   never honored, so the verdict it waited on was never returned in line.
set -uo pipefail

GAP_CAP_SECONDS=3600

# Print the header block, however long it is. A hardcoded end line silently
# truncates --help, or spills shell code into it, the next time the contract
# above gains or loses a paragraph.
usage() {
  awk 'NR > 1 { if ($0 !~ /^#/) exit; sub(/^# ?/, ""); print }' "${BASH_SOURCE[0]}"
}

SINCE=""
PROJECT_DIR=""
JSON=0
INCLUDE_ALL=0
RULES=0

while [ $# -gt 0 ]; do
  case "$1" in
    --since) SINCE="${2:-}"; shift 2 ;;
    --project) PROJECT_DIR="${2:-}"; shift 2 ;;
    --json) JSON=1; shift ;;
    --include-all) INCLUDE_ALL=1; shift ;;
    --rules) RULES=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "session-metrics: unknown arg: $1" >&2; exit 2 ;;
  esac
done

command -v jq >/dev/null 2>&1 || { echo "session-metrics: jq is required" >&2; exit 0; }

TRANSCRIPT_ROOT="${SESSION_METRICS_ROOT:-$HOME/.claude/projects}"
if [ ! -d "$TRANSCRIPT_ROOT" ]; then
  echo "session-metrics: no transcript store at $TRANSCRIPT_ROOT" >&2
  exit 0
fi

since_epoch="null"
if [ -n "$SINCE" ]; then
  epoch="$(date -d "$SINCE" +%s 2>/dev/null || date -j -f '%Y-%m-%dT%H:%M:%SZ' "$SINCE" +%s 2>/dev/null || date -j -f '%Y-%m-%d' "$SINCE" +%s 2>/dev/null)"
  if [ -z "$epoch" ]; then
    echo "session-metrics: unparseable --since value: $SINCE" >&2
    exit 2
  fi
  since_epoch="$epoch"
fi

slugify() { printf '%s' "$1" | sed -E 's/[^A-Za-z0-9]/-/g'; }

# No maxdepth: subagent transcripts live at <slug>/<session-uuid>/subagents/**
# and are the majority of the files. The mindepth is what still holds, so a
# stray .jsonl dropped in the transcript root is not read as a session.
if [ -n "$PROJECT_DIR" ]; then
  search_root="$TRANSCRIPT_ROOT/$(slugify "$PROJECT_DIR")"
  find_args=(-mindepth 1)
else
  search_root="$TRANSCRIPT_ROOT"
  find_args=(-mindepth 2)
fi

if [ ! -d "$search_root" ]; then
  echo "session-metrics: no sessions under $search_root" >&2
  exit 0
fi

mapfile -t FILES < <(find "$search_root" "${find_args[@]}" -type f -name '*.jsonl' 2>/dev/null | sort)

# --- the advisory rules to measure (--rules only) ---------------------------
# Read from the enforcement contract rather than hardcoded here, so the metric
# and the hook cannot drift: enforcement.toml carries the literal the hook
# emits, and a rule promoted out of "advisory" leaves this report by itself.
# lib-toml.sh reads exactly one file and leaves layer precedence to its caller,
# so the three layers are walked here, first hit wins per key.
ADVISORY_JSON='[]'
CONTRACT_LAYERS_JSON='[]'
if [ "$RULES" -eq 1 ]; then
  repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
  lib_toml="$repo_root/plugins/megapowers/hooks/lib-toml.sh"
  if [ ! -r "$lib_toml" ]; then
    # Still a report: the other three metrics come from the transcript alone.
    echo "session-metrics: no TOML reader at $lib_toml; advisory honor rate not measured" >&2
  else
    # shellcheck source=../plugins/megapowers/hooks/lib-toml.sh
    . "$lib_toml"

    # The project layer belongs to the project being MEASURED. Resolved against
    # the cwd, `--rules --project /other/repo` scored that repository's
    # transcripts against this one's fire_prefix, honor_window, and advisory rule
    # set, and reported the mismatch as a clean zero.
    enf_project_root="${PROJECT_DIR:-$PWD}"
    enf_layers=()
    [ -r "$enf_project_root/.megapowers/enforcement.toml" ] && enf_layers+=("$enf_project_root/.megapowers/enforcement.toml")
    enf_user="${XDG_CONFIG_HOME:-$HOME/.config}/megapowers/enforcement.toml"
    [ -r "$enf_user" ] && enf_layers+=("$enf_user")
    enf_shipped="$repo_root/plugins/megapowers/enforcement.toml"
    [ -r "$enf_shipped" ] && enf_layers+=("$enf_shipped")

    # First layer that DEFINES the key wins, which is why the existence check is
    # separate from the read: a layer setting a key to the empty string must
    # still win over the layer below it.
    enf_key() {
      local section="$1" key="$2" layer
      for layer in ${enf_layers[@]+"${enf_layers[@]}"}; do
        toml_key_exists_in "$layer" "$section" "$key" || continue
        toml_scalar_in "$layer" "$section" "$key"
        return 0
      done
    }

    adv_entries=()
    while IFS= read -r rule; do
      [ -n "$rule" ] || continue
      [ "$(enf_key "rules.$rule" state)" = "advisory" ] || continue
      prefix="$(enf_key "rules.$rule" fire_prefix)"
      window="$(enf_key "rules.$rule" honor_window)"
      # A rule with no fire_prefix leaves no trace in a transcript, and a
      # non-numeric window has no window. Say so once and keep going rather
      # than reporting a zero that reads like perfect silence from the hook.
      if [ -z "$prefix" ] || ! [[ $window =~ ^[0-9]+$ ]]; then
        echo "session-metrics: rules.$rule is advisory but carries no usable fire_prefix/honor_window; not measured" >&2
        continue
      fi
      adv_entries+=("$(jq -n -c --arg rule "$rule" --arg fp "$prefix" --argjson hw "$window" \
        '{rule: $rule, fire_prefix: $fp, honor_window: $hw}')")
    done < <(for layer in ${enf_layers[@]+"${enf_layers[@]}"}; do
      awk '{h=$0; gsub(/[[:space:]]/,"",h)} h ~ /^\[rules\.[A-Za-z0-9_-]+\]$/ {n=h; sub(/^\[rules\./,"",n); sub(/\]$/,"",n); print n}' "$layer"
    done | sort -u)

    ADVISORY_JSON="$(printf '%s\n' ${adv_entries[@]+"${adv_entries[@]}"} | jq -c -s '.')"
    # Reported, because which contract a number was measured against is part of
    # the number. A reader seeing zero fires needs to tell "the hook is quiet"
    # from "the layer I meant was never read".
    CONTRACT_LAYERS_JSON="$(printf '%s\n' ${enf_layers[@]+"${enf_layers[@]}"} | jq -R -c -s 'split("\n") | map(select(length > 0))')"
  fi
fi

# --- per-session extraction -------------------------------------------------
# Emits one compact JSON object per session (its scalar span/turn fields plus
# the raw arrays the combine pass pools for the aggregate row). A session
# excluded entirely by the isSidechain/entrypoint/--since filters emits
# nothing.
read -r -d '' EXTRACT_JQ <<'JQ'
def parse_ts:
  . as $s
  | ($s | sub("\\.[0-9]+Z$"; "Z")) as $whole
  | ($whole | strptime("%Y-%m-%dT%H:%M:%SZ") | mktime) as $sec
  | ($s | if test("\\.[0-9]+Z$") then (capture("\\.(?<f>[0-9]+)Z$").f | ("0." + .) | tonumber) else 0 end) as $frac
  | $sec + $frac;

( . ) as $all
| ( [ $all[] | .entrypoint | select(. != null) ] | first ) as $session_entrypoint
| ( [ $all[] | .isSidechain | select(. != null) ] | first ) as $session_is_sidechain
| ( if $include_all then $all
    elif (($session_entrypoint // "cli") == "cli") and (($session_is_sidechain // false) != true) then $all
    else []
    end
  ) as $recs
| if ($recs | length) == 0 then empty else
( [ $recs[] | select(.timestamp != null) ] ) as $timed
| if ($timed | length) == 0 then empty else
# Position-tagged user and assistant records. The index is over $timed, so it
# orders assistant groups against the user records that separate them even
# though attachment and other record types sit between.
( [ $timed | to_entries[]
    | select(.value.type == "user" or .value.type == "assistant")
    | {i: .key, type: .value.type, ts: (.value.timestamp | parse_ts),
       gid: (.value.message.id // ("__nomsgid-" + (.key | tostring))),
       ntu: ([.value.message.content[]? | select(.type == "tool_use")] | length)}
  ] ) as $seq
# One model response per group of assistant records sharing a message.id.
| ( [ $seq[] | select(.type == "assistant") ]
    | group_by(.gid) | map(sort_by(.i)) | sort_by(.[0].i) ) as $groups
| ( [ range(0; ($groups | length)) as $k
      | ($groups[$k][0].i) as $cur_start
      | (if $k == 0 then -1 else $groups[$k-1][-1].i end) as $prev_end
      | ( [ $seq[] | select(.type == "user" and .i > $prev_end and .i < $cur_start) | .ts ]
          | max ) as $input_ready
      | ( if $input_ready != null then $input_ready
          elif $k > 0 then $groups[$k-1][-1].ts
          else null end ) as $base
      | select($base != null)
      | (($groups[$k][0].ts - $base) | if . < 0 then 0 else . end)
    ] ) as $latencies
| ( [ $recs[] | select(.type == "assistant")
      | .timestamp as $ts
      | .message.content[]? | select(.type == "tool_use")
      | {id, name, start: ($ts | parse_ts), rib: (.input.run_in_background == true)}
    ] ) as $starts
| ( [ $recs[] | select(.type == "user")
      | .timestamp as $ts
      | .message.content[]? | select(.type == "tool_result")
      | {id: .tool_use_id, end: ($ts | parse_ts)}
    ] ) as $ends
| ( $ends | map({(.id): .end}) | add // {} ) as $endmap
| ( [ $starts[] | . as $s | ($endmap[$s.id]) as $e | select($e != null) | {name: $s.name, wall: ($e - $s.start)} ] ) as $pairs
| ( [ $pairs[] | select(.wall < $gap_cap) ] ) as $kept
| ( [ $pairs[] | select(.wall >= $gap_cap) ] | length ) as $excluded
# tool_use blocks per model response, summed across the response's records.
| ( [ $groups[] | ([.[].ntu] | add) ] ) as $tucounts
| ( [ $starts[] | select(.name == "Bash") ] ) as $bash_calls
| ( [ $recs[] | select(.type == "attachment") | select(.attachment.durationMs != null)
      | select(
          (.attachment.exitCode != null and .attachment.exitCode != 0)
          or (
            ( [ .attachment.stdout, .attachment.stderr,
                (.attachment.content // "" | if type == "array" then join(" ") else tostring end) ]
              | join(" ") )
            | contains("Plugin directory does not exist")
          )
        )
    ] | length ) as $hook_failures
| {
    session_id: ($recs[0].sessionId // "unknown"),
    project_cwd: (([$timed[] | select(.cwd != null) | .cwd] | first) // ""),
    span_start: $timed[0].timestamp,
    span_start_epoch: ($timed[0].timestamp | parse_ts),
    span_end: $timed[-1].timestamp,
    span_end_epoch: ($timed[-1].timestamp | parse_ts),
    assistant_turns: ($groups | length),
    latencies: $latencies,
    tool_wall: $kept,
    tool_wall_excluded: $excluded,
    turn_tool_counts: $tucounts,
    bash_backgrounded: ([$bash_calls[] | select(.rib)] | length),
    bash_total: ($bash_calls | length),
    skill_invocations: ([$starts[] | select(.name == "Skill")] | length),
    hook_failures: $hook_failures
  }
| select($since_epoch == null or .span_end_epoch >= $since_epoch)
| select(.assistant_turns > 0)
end
end
JQ

# --- per-session extraction for --rules -------------------------------------
# A separate program rather than more fields on the one above: none of the four
# rule metrics needs a latency or a tool-wall array, and the default report is
# the hot path. It repeats the isSidechain/entrypoint/--since filters verbatim
# so a session counts, or does not, identically in both reports.
read -r -d '' RULES_JQ <<'JQ'
def parse_ts:
  . as $s
  | ($s | sub("\\.[0-9]+Z$"; "Z")) as $whole
  | ($whole | strptime("%Y-%m-%dT%H:%M:%SZ") | mktime) as $sec
  | ($s | if test("\\.[0-9]+Z$") then (capture("\\.(?<f>[0-9]+)Z$").f | ("0." + .) | tonumber) else 0 end) as $frac
  | $sec + $frac;

# The transcript records a block's reason, never the rule that produced it, so
# the rule is recovered from the words the reason opens with. Both the current
# and the legacy risky-logic wording map to the one rule: a rename of the block
# text is not a second gate, and splitting them would hide exactly the
# concentration this metric exists to show.
def rule_of:
  ascii_downcase
  | if startswith("risky auth") or startswith("risky logic")
       or startswith("pending changes cannot be checked")
       or startswith("this gate could not compute")
       or startswith("a megapowers.review-receipt") then "risky-logic-review"
    elif startswith("autonomous run") then "autonomous-run-continuation"
    else "unclassified" end;

# tool_result content is a plain string for Bash and an array of blocks for
# tools that return structured output. Both are flattened to one searchable
# string; nothing downstream cares which shape it came from.
def result_text:
  if type == "array" then ([.[] | .text? // ""] | join(" ")) else tostring end;

( . ) as $all
| ( [ $all[] | .entrypoint | select(. != null) ] | first ) as $session_entrypoint
| ( [ $all[] | .isSidechain | select(. != null) ] | first ) as $session_is_sidechain
| ( if $include_all then $all
    elif (($session_entrypoint // "cli") == "cli") and (($session_is_sidechain // false) != true) then $all
    else []
    end
  ) as $recs
| if ($recs | length) == 0 then empty else
( [ $recs[] | select(.timestamp != null) ] ) as $timed
| if ($timed | length) == 0 then empty else
# Assistant records carry their position so a fire can look forward over the
# honor window. The window is records, not responses: honor_window is stated in
# the contract in the same unit.
( [ $recs | to_entries[] | select(.value.type == "assistant")
    | {i: .key,
       skills: [ .value.message.content[]? | select(.type == "tool_use" and .name == "Skill")
                 | ((.input.skill // "") | sub("^[^:]*:"; "")) ]}
  ] ) as $arecs
| ( [ $advisory[] | . as $adv
      # A fire is a hook DELIVERY, which the harness writes as an attachment of
      # type hook_additional_context. Nothing else is the hook speaking.
      | ( [ $recs | to_entries[]
            | select(.value.type == "attachment"
                     and .value.attachment.type == "hook_additional_context")
            | .key as $i
            # Every occurrence counts, not every record: one delivery carrying
            # the prefix twice is two fires. The tail after each split starts at
            # the skill name the hook named.
            | ((.value | tostring) | split($adv.fire_prefix))[1:][]
            | {i: $i, skill: ((capture("^(?<s>[A-Za-z0-9_-]+)") | .s) // "unknown")}
          ] ) as $fires
      # Every other record carrying the literal is an echo: a grep of the hook's
      # source, a tool_result printing enforcement.toml, a task brief quoting it,
      # the model repeating the line back. Counted separately and never as a
      # fire, because on this author's store the echoes outnumbered the
      # deliveries four to one and dragged a real 100% honor rate down to 22%.
      # Kept in the output so a harness that renames the delivery shape reads as
      # zero fires beside a live echo count rather than as silence.
      | ( [ $recs[]
            | select(.type != "attachment"
                     or .attachment.type != "hook_additional_context")
            | ((. | tostring) | split($adv.fire_prefix))[1:][]
          ] | length ) as $echoes
      | {rule: $adv.rule,
         fires: ($fires | length),
         echoes: $echoes,
         honored: ( [ $fires[] | . as $f
                      | ( [ $arecs[] | select(.i > $f.i) ][0:$adv.honor_window] ) as $win
                      | select([$win[].skills[]] | index($f.skill))
                    ] | length )}
    ] ) as $advisory_counts
# One block per hook_blocking_error attachment. The system/stop_hook_summary
# record the harness writes next to it repeats the same reason, so counting both
# would double every gate fire. hookEvent is present on every blocking error the
# harness writes today; a record that lost it is read as a Stop block rather
# than dropped, because a metric that silently reads zero is worse than one that
# over-counts an event nobody has produced.
| ( [ $recs[] | select(.type == "attachment")
      | select(.attachment.type == "hook_blocking_error")
      | select((.attachment.hookEvent // "Stop") == "Stop")
      | {rule: (((.attachment.blockingError.blockingError // .attachment.blockingError // "") | tostring) | rule_of),
         project: (.cwd // "unknown")}
    ] ) as $blocks
| ( [ $recs[] | select(.type == "assistant") | .timestamp as $ts
      | .message.content[]? | select(.type == "tool_use" and .name == "Bash")
      | {id, start: ($ts | parse_ts),
         dr: (((.input.command // "") | tostring) | contains("delegate-run"))}
    ] ) as $bash_calls
| ( [ $recs[] | select(.type == "user") | .timestamp as $ts
      | .message.content[]? | select(.type == "tool_result")
      | {id: .tool_use_id, end: ($ts | parse_ts), text: (.content | result_text)}
    ] ) as $results
| ( $results | map({(.id): .}) | add // {} ) as $resmap
| ( $bash_calls | map({(.id): true}) | add // {} ) as $bash_ids
# Only a Bash result can be delegate-run's own stdout. Reading or grepping the
# launcher's source prints the same sentence, and counting that as a dispatch
# would put this repository's rounds at the top of every report.
| ( [ $results[] | select($bash_ids[.id] == true) | .text
      | match("consecutive dispatch ([0-9]+) of role '([^']*)' on '([^']*)' without an approve"; "g")
      | {round: (.captures[0].string | tonumber),
         role: .captures[1].string,
         branch: .captures[2].string}
    ] ) as $rounds
| ( [ $bash_calls[] | select(.dr) ] ) as $dr_calls
| ( [ $dr_calls[] | . as $c | ($resmap[$c.id]) as $r | select($r != null)
      | {wall: ($r.end - $c.start),
         backgrounded: ($r.text | contains("did not complete within its"))}
    ] ) as $dr_pairs
| {
    project_cwd: (([$timed[] | select(.cwd != null) | .cwd] | first) // ""),
    span_end_epoch: ($timed[-1].timestamp | parse_ts),
    advisory: $advisory_counts,
    gate_blocks: $blocks,
    rounds: $rounds,
    delegate_run_calls: ($dr_calls | length),
    delegate_run_pairs: $dr_pairs
  }
| select($since_epoch == null or .span_end_epoch >= $since_epoch)
# A session that carries none of the four signals is dropped here rather than
# pooled as zeros: the rule list the combine pass reports comes from the
# contract, not from whichever session happened to survive. Echoes count as a
# signal even though they are not fires. Dropping an echo-only session would
# undo the guard above: a harness that renamed the delivery shape would leave
# every session with zero fires, every one of them dropped, and the echo count
# back at zero.
| select((.advisory | map(.fires + .echoes) | add // 0) > 0
         or (.gate_blocks | length) > 0
         or (.rounds | length) > 0
         or .delegate_run_calls > 0)
end
end
JQ

# Extracted per-session objects are appended to an NDJSON scratch file rather
# than threaded through --argjson: a session's raw latency/tool-wall arrays
# can be large, and repeatedly round-tripping a growing JSON blob through
# argv blows past the OS argument-length limit on a big transcript store.
scratch_dir="$(mktemp -d "${TMPDIR:-/tmp}/session-metrics.XXXXXX")"
trap 'rm -rf "$scratch_dir"' EXIT
ndjson="$scratch_dir/sessions.ndjson"
: > "$ndjson"

extract_program="$EXTRACT_JQ"
[ "$RULES" -eq 1 ] && extract_program="$RULES_JQ"

for f in "${FILES[@]:-}"; do
  [ -n "$f" ] || continue
  jq -R -c 'fromjson? // empty' "$f" 2>/dev/null \
    | jq -c -s \
        --argjson include_all "$([ "$INCLUDE_ALL" -eq 1 ] && echo true || echo false)" \
        --argjson gap_cap "$GAP_CAP_SECONDS" \
        --argjson since_epoch "$since_epoch" \
        --argjson advisory "$ADVISORY_JSON" \
        "$extract_program" 2>/dev/null \
    >> "$ndjson"
done

sessions_json="$(jq -c -s '.' "$ndjson")"

# --- combine and render: --rules --------------------------------------------
# Pooled only. Every one of the four numbers is a cross-session distribution:
# per-session honor rates over two fires, or a per-session round maximum, say
# nothing, and the concentration the gate metric exists to show is invisible
# inside one session.
if [ "$RULES" -eq 1 ]; then
  read -r -d '' RULES_COMBINE_JQ <<'JQ'
def pct(p):
  sort as $s
  | ($s | length) as $n
  | if $n == 0 then null
    else ($s[(($n * p | floor) as $i | if $i >= $n then $n - 1 else $i end)])
    end;

def r2: (. * 100 | round) / 100;

. as $sessions
| ( [ $sessions[].advisory[] ] ) as $adv
| ( [ $sessions[].gate_blocks[] ] ) as $blocks
| ( [ $sessions[].rounds[] ] ) as $rounds
| ( [ $sessions[].delegate_run_pairs[] ] ) as $dr
| ( [ $sessions[].delegate_run_calls ] | add // 0 ) as $dr_calls
| ( [ $dr[] | select(.wall < $gap_cap) | .wall ] ) as $dr_walls
| ( [ $advisory[] | .rule as $r
      | {rule: $r,
         honor_window: .honor_window,
         fires: ([$adv[] | select(.rule == $r) | .fires] | add // 0),
         echoes: ([$adv[] | select(.rule == $r) | .echoes] | add // 0),
         honored: ([$adv[] | select(.rule == $r) | .honored] | add // 0)}
      | . + {honor_rate: (if .fires == 0 then null else (.honored / .fires | r2) end)}
    ] ) as $per_rule
| {
    contract_layers: $layers,
    advisory_honor: {
      rules: $per_rule,
      fires: ([$per_rule[].fires] | add // 0),
      echoes: ([$per_rule[].echoes] | add // 0),
      honored: ([$per_rule[].honored] | add // 0)
    },
    gate_fires: {
      total: ($blocks | length),
      by_rule: ($blocks | group_by(.rule) | map({key: .[0].rule, value: length}) | from_entries),
      by_project: ($blocks | group_by(.project)
                   | map({project: .[0].project, count: length})
                   | sort_by(-.count))
    },
    verify_rounds: {
      dispatches: ($rounds | length),
      max_round: ([$rounds[].round] | max),
      distribution: ($rounds | group_by(.round)
                     | map({key: (.[0].round | tostring), value: length}) | from_entries),
      by_key: ($rounds | group_by([.role, .branch])
               | map({role: .[0].role, branch: .[0].branch,
                      dispatches: length, max_round: ([.[].round] | max)})
               | sort_by(-.max_round))
    },
    delegate_run: {
      invocations: $dr_calls,
      measured: ($dr_walls | length),
      total_h: (($dr_walls | add // 0) / 3600 | r2),
      median_s: ($dr_walls | pct(0.5) | if . == null then null else r2 end),
      p90_s: ($dr_walls | pct(0.9) | if . == null then null else r2 end),
      excluded_long_gaps: ([$dr[] | select(.wall >= $gap_cap)] | length),
      backgrounded: ([$dr[] | select(.backgrounded)] | length)
    }
  }
| .advisory_honor
  |= (. + {honor_rate: (if .fires == 0 then null else (.honored / .fires | r2) end)})
JQ

  rules_json="$(printf '%s' "$sessions_json" \
    | jq -c --argjson advisory "$ADVISORY_JSON" --argjson gap_cap "$GAP_CAP_SECONDS" \
        --argjson layers "$CONTRACT_LAYERS_JSON" "$RULES_COMBINE_JQ")"

  if [ "$JSON" -eq 1 ]; then
    printf '%s\n' "$rules_json" | jq '{rules: .}'
    exit 0
  fi

  printf '%s\n' "$rules_json" | jq -r '
    def show(x; unit): if x == null then "n/a" else "\(x)\(unit)" end;
    def rate(x): if x == null then "n/a" else "\((x * 100 | round))%" end;
    "=== advisory rules (honored when the named skill is invoked in the window) ===",
    "  contract: " + ((.contract_layers | join(", ")) | if . == "" then "none read" else . end),
    (if (.advisory_honor.rules | length) == 0 then "  (no advisory rule declares a fire_prefix)"
     else (.advisory_honor.rules[]
           | "  \(.rule): \(.fires) fires, \(.honored) honored (\(rate(.honor_rate))), window \(.honor_window) assistant records",
             "    echoes (the literal quoted outside a hook delivery, not fires): \(.echoes)")
     end),
    "  all advisory rules: \(.advisory_honor.fires) fires, \(.advisory_honor.honored) honored (\(rate(.advisory_honor.honor_rate)))",
    "",
    "=== gate fires (Stop-hook blocks) ===",
    "  total: \(.gate_fires.total)",
    "  by rule: " + ((.gate_fires.by_rule | to_entries | map("\(.key) \(.value)") | join(", ")) | if . == "" then "none" else . end),
    "  top projects: " + ((.gate_fires.by_project[0:5] | map("\(.project) \(.count)") | join(", ")) | if . == "" then "none" else . end),
    "",
    "=== verify rounds to approve ===",
    "  dispatches with a round line: \(.verify_rounds.dispatches), max round \(show(.verify_rounds.max_round; ""))",
    "  distribution: " + ((.verify_rounds.distribution | to_entries | sort_by(.key | tonumber) | map("round \(.key) x\(.value)") | join(", ")) | if . == "" then "none" else . end),
    (.verify_rounds.by_key[0:5][] | "  \(.role) on \(.branch): max round \(.max_round) over \(.dispatches) dispatches"),
    "",
    "=== delegate-run wall clock ===",
    "  invocations: \(.delegate_run.invocations), measured \(.delegate_run.measured) (excluded \(.delegate_run.excluded_long_gaps) long-gap calls)",
    "  total \(.delegate_run.total_h)h, median \(show(.delegate_run.median_s; "s")), p90 \(show(.delegate_run.p90_s; "s"))",
    "  hit the harness Bash cap and were backgrounded: \(.delegate_run.backgrounded)"
  '
  exit 0
fi

# --- combine: per-session view plus one pooled aggregate --------------------
read -r -d '' COMBINE_JQ <<'JQ'
def pct(p):
  sort as $s
  | ($s | length) as $n
  | if $n == 0 then null
    else ($s[(($n * p | floor) as $i | if $i >= $n then $n - 1 else $i end)])
    end;

def r2: (. * 100 | round) / 100;

def by_tool_breakdown:
  group_by(.name)
  | map({key: .[0].name, value: {count: length, total_h: ((map(.wall) | add) / 3600 | r2)}})
  | from_entries;

def view($lat; $wall; $excluded; $tuc; $bg; $bash_total; $skill; $hook; $turns):
  {
    assistant_turns: $turns,
    model_latency: {
      median_s: ($lat | pct(0.5) | if . == null then null else r2 end),
      p90_s: ($lat | pct(0.9) | if . == null then null else r2 end),
      total_h: (($lat | add // 0) / 3600 | r2)
    },
    tool_wall_clock: {
      total_h: (([$wall[].wall] | add // 0) / 3600 | r2),
      excluded_long_gaps: $excluded,
      by_tool: ($wall | by_tool_breakdown)
    },
    bash_p90_s: ([$wall[] | select(.name == "Bash") | .wall] | pct(0.9) | if . == null then null else r2 end),
    batched_tool_call_ratio: (
      ($tuc | map(select(. > 0)) | length) as $t
      | if $t == 0 then null else (($tuc | map(select(. > 1)) | length) / $t | r2) end
    ),
    backgrounded_bash_ratio: (if $bash_total == 0 then null else ($bg / $bash_total | r2) end),
    skill_invocations: $skill,
    hook_failures: $hook
  };

. as $sessions
| ($sessions | map(
    {
      session_id, project_cwd, span_start, span_end
    } + view(.latencies; .tool_wall; .tool_wall_excluded; .turn_tool_counts;
             .bash_backgrounded; .bash_total; .skill_invocations; .hook_failures;
             .assistant_turns)
  )) as $per_session
| {
    sessions: $per_session,
    aggregate: (
      ($sessions | map(.latencies[])) as $all_lat
      | ($sessions | map(.tool_wall[])) as $all_wall
      | ($sessions | map(.tool_wall_excluded) | add // 0) as $all_excluded
      | ($sessions | map(.turn_tool_counts[])) as $all_tuc
      | ($sessions | map(.bash_backgrounded) | add // 0) as $agg_bg
      | ($sessions | map(.bash_total) | add // 0) as $agg_bash_total
      | ($sessions | map(.skill_invocations) | add // 0) as $agg_skill
      | ($sessions | map(.hook_failures) | add // 0) as $agg_hook
      | ($sessions | map(.assistant_turns) | add // 0) as $agg_turns
      | ($sessions | map(.span_start_epoch) | min) as $agg_start_epoch
      | ($sessions | map(.span_end_epoch) | max) as $agg_end_epoch
      | (if $agg_start_epoch == null then null
         else ($sessions | map(select(.span_start_epoch == $agg_start_epoch)) | .[0].span_start) end
        ) as $agg_span_start
      | (if $agg_end_epoch == null then null
         else ($sessions | map(select(.span_end_epoch == $agg_end_epoch)) | .[0].span_end) end
        ) as $agg_span_end
      | {session_count: ($sessions | length), span_start: $agg_span_start, span_end: $agg_span_end}
        + view($all_lat; $all_wall; $all_excluded; $all_tuc; $agg_bg; $agg_bash_total; $agg_skill; $agg_hook; $agg_turns)
    )
  }
JQ

report_json="$(printf '%s' "$sessions_json" | jq -c "$COMBINE_JQ")"

if [ "$JSON" -eq 1 ]; then
  printf '%s\n' "$report_json" | jq .
  exit 0
fi

if [ "$(printf '%s' "$sessions_json" | jq 'length')" -eq 0 ]; then
  echo "session-metrics: no sessions matched under $search_root"
  exit 0
fi

printf '%s\n' "$report_json" | jq -r '
  def show(x; unit): if x == null then "n/a" else "\(x)\(unit)" end;
  def line(o):
    "  span: \(o.span_start) to \(o.span_end)\n" +
    "  assistant turns: \(o.assistant_turns)\n" +
    "  model latency: median \(show(o.model_latency.median_s; "s")), p90 \(show(o.model_latency.p90_s; "s")), total \(o.model_latency.total_h)h\n" +
    "  tool wall clock: total \(o.tool_wall_clock.total_h)h (excluded \(o.tool_wall_clock.excluded_long_gaps) long-gap calls)\n" +
    "    by tool: " + ((o.tool_wall_clock.by_tool | to_entries | map("\(.key) \(.value.total_h)h/\(.value.count)") | join(", ")) // "none") + "\n" +
    "  bash p90: \(show(o.bash_p90_s; "s"))\n" +
    "  batched-tool-call ratio: \(show(o.batched_tool_call_ratio; ""))\n" +
    "  backgrounded-bash ratio: \(show(o.backgrounded_bash_ratio; ""))\n" +
    "  skill invocations: \(o.skill_invocations)\n" +
    "  hook failures: \(o.hook_failures)\n";
  (.sessions[] | "session \(.session_id) (\(.project_cwd))\n" + line(.)),
  ("=== aggregate (\(.aggregate.session_count) sessions) ===\n" + line(.aggregate))
'
