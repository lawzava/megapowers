{
  "includeCoAuthoredBy": false,
  "attribution": { "commit": "", "pr": "", "sessionUrl": false },
  "includeGitInstructions": false,
  "disableArtifact": true,
  "disableWorkflows": true,
  "disableClaudeAiConnectors": true,
  "spinnerTipsEnabled": false,
  "promptSuggestionEnabled": false,
  "awaySummaryEnabled": false,
  "skillOverrides": {
    "artifact-capabilities": "off",
    "artifact-design": "off",
    "artifact-diagramming": "off",
    "claude-in-chrome": "off",
    "dataviz": "off",
    "fewer-permission-prompts": "user-invocable-only",
    "init": "user-invocable-only",
    "keybindings-help": "user-invocable-only",
    "review": "user-invocable-only",
    "run": "user-invocable-only",
    "security-review": "user-invocable-only",
    "simplify": "user-invocable-only",
    "update-config": "user-invocable-only"
  },
  "env": {
    "CLAUDE_CODE_DISABLE_EXPLORE_PLAN_AGENTS": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1"
  },
  "permissions": {
    "allow": [
      "Bash(playwright-cli:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./secrets)",
      "Read(~/.ssh)",
      "Read(~/.aws)",
      "Read(~/.gnupg)",
      "Read(~/.netrc)",
      "Read(~/.pgpass)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "credentials": {
      "files": [
        { "path": "~/.ssh", "mode": "deny" },
        { "path": "~/.aws", "mode": "deny" },
        { "path": "~/.gnupg", "mode": "deny" },
        { "path": "~/.netrc", "mode": "deny" },
        { "path": "~/.pgpass", "mode": "deny" },
        { "path": ".env", "mode": "deny" },
        { "path": ".env.local", "mode": "deny" },
        { "path": ".env.production", "mode": "deny" },
        { "path": "secrets", "mode": "deny" }
      ],
      "envVars": [
        { "name": "GITHUB_TOKEN", "mode": "deny" },
        { "name": "NPM_TOKEN", "mode": "deny" },
        { "name": "AWS_ACCESS_KEY_ID", "mode": "deny" },
        { "name": "AWS_SECRET_ACCESS_KEY", "mode": "deny" }
      ]
    }
  },
  "autoMode": {
    "soft_deny": [
      "$defaults",
      "Any INSERT, UPDATE, DELETE, TRUNCATE, or DDL statement against a production database host",
      "Modifying files under ~/.claude or shell profiles unless the user explicitly asked for it"
    ],
    "environment": [
      "$defaults",
      "REPLACE: one line describing this machine and its primary work (e.g. 'headless Linux VPS; Go services under ~/Code, deployed via CI').",
      "REPLACE: which databases/hosts are dev (safe to query) and which are PRODUCTION (read-only at most).",
      "REPLACE: what is routine here (test suites, local containers) so the classifier stops asking about it."
    ]
  }
}
